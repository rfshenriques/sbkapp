POSTGRES_USER=sportsbook
POSTGRES_PASSWORD=sportsbook
POSTGRES_DB=sportsbook
# Generate your own: `openssl rand -hex 32`
JWT_SECRET=replace-with-a-random-secret
# Generate your own: `openssl rand -hex 32`
STAFF_JWT_SECRET=replace-with-a-random-secret
# Generate your own: `openssl rand -hex 24`
ADMIN_API_KEY=replace-with-a-random-secret
# Generate your own: `openssl rand -hex 32`
MASTER_JWT_SECRET=replace-with-a-random-secret
# Generate your own: `openssl rand -hex 24`
MASTER_ADMIN_KEY=replace-with-a-random-secret
# Which brand apps/frontend registers new players into - defaults to the
# seeded "Default Brand". Get a real brand's id from the master
# backoffice once you've created one.
VITE_BRAND_ID=00000000-0000-0000-0000-000000000001
