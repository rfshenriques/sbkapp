# Which brand this deployment registers new players into - see the
# brandId retrofit in PROJECT_BRIEF.md Section 10. There's no
# domain-based tenant resolution yet, so each deployment of this app is
# pinned to one brand via this var rather than the player picking one at
# registration. Get a brand's id from the master backoffice
# (apps/master-backoffice) after creating it, or use the seeded
# "Default Brand" (00000000-0000-0000-0000-000000000001) for local dev.
VITE_BRAND_ID=00000000-0000-0000-0000-000000000001
