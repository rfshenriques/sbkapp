DATABASE_URL="postgresql://sportsbook:sportsbook@localhost:5432/sportsbook"
# Generate your own: `openssl rand -hex 32`
JWT_SECRET="replace-with-a-random-secret"
# Deliberately separate from JWT_SECRET - staff and player tokens must
# never be interchangeable. Generate your own: `openssl rand -hex 32`
STAFF_JWT_SECRET="replace-with-a-random-secret"
# Bootstrap-only gate for creating the first staff accounts (POST
# /admin/staff-users) - staff log in for real after that. Generate your
# own: `openssl rand -hex 24`
ADMIN_API_KEY="replace-with-a-random-secret"
# Deliberately separate from every other secret above - the master
# backoffice's single-owner login must never be reachable by a staff or
# player token. Generate your own: `openssl rand -hex 32`
MASTER_JWT_SECRET="replace-with-a-random-secret"
# Bootstrap-only gate for creating the first (and likely only) master
# user (POST /master/auth/bootstrap). Generate your own: `openssl rand -hex 24`
MASTER_ADMIN_KEY="replace-with-a-random-secret"
# apps/odds-engine's base URL - the margin pricing module fetches raw feed
# odds from here server-side and applies each brand's configured margin
# before serving apps/frontend (see modules/margins/odds-engine-client.ts).
# In docker-compose this is http://odds-engine:4001 instead.
ODDS_ENGINE_URL="http://localhost:4001"
