DATABASE_URL="postgresql://sportsbook:sportsbook@localhost:5432/sportsbook"
# Generate your own: `openssl rand -hex 32`
JWT_SECRET="replace-with-a-random-secret"
# Deliberately separate from JWT_SECRET - staff and player tokens must
# never be interchangeable. Generate your own: `openssl rand -hex 32`
STAFF_JWT_SECRET="replace-with-a-random-secret"
# Bootstrap-only gate for creating the first staff accounts (POST
# /admin/staff-users) - staff log in for real after that. Generate your
# own: `openssl rand -hex 24`
ADMIN_API_KEY="replace-with-a-random-secret"
