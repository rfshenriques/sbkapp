generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  /**
   * Kept globally unique rather than unique-per-brand for now: there's no
   * domain-based tenant resolution yet (see PROJECT_BRIEF.md Section 10),
   * so a pre-auth request (register, login) has no other way to know
   * which brand it's for. Login therefore still looks a user up globally
   * by email/username and reads brandId off the row it finds; register
   * requires an explicit brandId in the request. Revisit once tenant
   * resolution exists - a real deployment will likely want these unique
   * per-brand instead.
   */
  email           String    @unique
  username        String    @unique
  phone           String    @unique
  phoneVerifiedAt DateTime?
  passwordHash    String
  /**
   * Paper money only - no real payments/currency handling yet, see PROJECT_BRIEF.md Section 10.
   */
  balanceCents    Int       @default(100000)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /**
   * Captured client-side on the register page's first mount (see
   * RegisterPage), not at submit, so it survives a player browsing around
   * before actually signing up. Nullable and forward-only - there's no way
   * to backfill these for users who registered before this existed.
   */
  referrerUrl String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /**
   * Bet slip preferences (see PamService.getBetSlipSettings/
   * updateBetSlipSettings) - server-stored per player rather than
   * localStorage, so they follow the player across devices. Guests never
   * read or write these (the bet slip falls back to fixed defaults while
   * logged out). betSlipQuickStakeCents always holds exactly 4 amounts.
   */
  betSlipAutoUpdateOdds  Boolean @default(false)
  betSlipQuickStakeCents Int[]   @default([500, 1000, 2500, 5000])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  refreshTokens               RefreshToken[]
  bets                        Bet[]
  segments                    PlayerSegmentMember[]
  freebetGrants               FreebetGrant[]
  deposits                    Deposit[]
  depositCampaignRedemptions  DepositCampaignRedemption[]
  registerCampaignRedemptions RegisterCampaignRedemption[]
  leaderboardEntries          LeaderboardEntry[]
  webAuthnCredentials         WebAuthnCredential[]
  pushSubscriptions           PushSubscription[]
  pushNotificationRecipients  PushNotificationRecipient[]

  @@index([brandId])
  @@map("users")
}

/**
 * One registered passkey/biometric credential (Face ID, Touch ID, Windows
 * Hello, a security key, ...) - see WebAuthnService. `credentialId` is the
 * authenticator-issued handle used to look up which user+key a login
 * assertion is claiming to be from; `counter` guards against a cloned
 * authenticator replaying an old signature (must strictly increase on
 * every use, except for known-zero multi-device passkeys where the spec
 * allows it to stay at 0).
 */
model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int
  transports   String[]
  deviceType   String
  backedUp     Boolean
  /**
   * Player-facing label for the device-management list, e.g. "iPhone" -
   * defaults to a generic name at registration time since the browser
   * doesn't hand over anything more specific than transports/deviceType.
   */
  nickname     String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

/**
 * An in-flight WebAuthn ceremony's server-generated challenge - single-use,
 * deleted the moment it's consumed by a matching verify call (see
 * WebAuthnService.consumeChallenge). userId is set for a registration
 * challenge (tied to the already-authenticated player registering a new
 * device) and null for a login challenge (identity isn't known until the
 * assertion comes back, since this is a discoverable-credential/usernameless
 * flow). No sweep job for expired-but-never-consumed rows - same "read-time
 * condition, not a swept status" tolerance this codebase already applies to
 * FreebetGrant.expiresAt.
 */
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  challenge String   @unique
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("webauthn_challenges")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum StaffRole {
  ADMIN
  TRADING
  RISK
  CRM
  FRAUD
  CMS
}

/**
 * A wholly separate identity system from User (players) - not a shared
 * login. See PROJECT_BRIEF.md Section 10: backoffice staff auth explicitly
 * isn't the same system as player auth. Kept globally unique on
 * email/username for the same pre-auth-lookup reason as User - see the
 * comment there.
 */
model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         StaffRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  refreshTokens StaffRefreshToken[]

  @@index([brandId])
  @@map("staff_users")
}

model StaffRefreshToken {
  id          String    @id @default(uuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
  @@map("staff_refresh_tokens")
}

