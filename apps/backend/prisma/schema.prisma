  STAFF_USER_BOOTSTRAPPED
  STAFF_USER_CREATED
  SELECTION_SETTLED
  MARKET_SUSPENDED
  MARKET_UNSUSPENDED
  COMPETITION_RANKING_SET
  COMPETITION_RANKING_REMOVED
  TEAM_COLOR_SET
  DISPLAY_NAME_OVERRIDE_SET
  BRAND_IMAGE_SET
  BRAND_IMAGE_REMOVED
  COMPETITION_TIER_SET
  COMPETITION_TIER_REMOVED
  MARGIN_CONFIG_SET
  MARGIN_CONFIG_REMOVED
  MARKETING_SPEND_CREATED
  MARKETING_SPEND_REMOVED
  BRAND_IMAGE_LIST_ITEM_ADDED
  BRAND_IMAGE_LIST_ITEM_REMOVED
  BRAND_IMAGE_LIST_REORDERED
  COMPETITION_SUSPENDED
  COMPETITION_UNSUSPENDED
  ODDS_OVERRIDE_SET
  ODDS_OVERRIDE_CLEARED
  MANUAL_MARKET_CREATED
  MANUAL_MARKET_REMOVED
  MANUAL_MARKET_UPDATED
  ODDS_LADDER_RUNG_ADDED
  ODDS_LADDER_RUNG_REMOVED
  ODDS_LADDER_REGENERATED
  BOOST_SET
  BOOST_CLEARED
  ACCA_BOOST_CONFIG_SET
  STAKE_LIMIT_SET
  STAKE_LIMIT_REMOVED
  STAKE_LIMITS_BULK_IMPORTED
  COMPETITION_QUICKLINK_SET
  COMPETITION_QUICKLINK_REMOVED
  PLAYER_SEGMENT_CREATED
  PLAYER_SEGMENT_REMOVED
  PLAYER_SEGMENT_MEMBER_ADDED
  PLAYER_SEGMENT_MEMBER_REMOVED
  PLAYER_SEGMENT_COLOR_SET
  MANUAL_MARKET_LIMITS_SET
  BOOST_LIMITS_SET
  BOOST_AUTO_DISABLED
  MANUAL_MARKET_AUTO_DISABLED
  FREEBET_GRANTED
  FREEBET_VOIDED
  ACCA_ROLLBACK_CONFIG_SET
  INSURANCE_BET_CONFIG_SET
  BET_AND_GET_CAMPAIGN_CREATED
  BET_AND_GET_CAMPAIGN_UPDATED
  BET_AND_GET_CAMPAIGN_REMOVED
  BET_AND_GET_CAMPAIGN_SCOPES_SET
  PROMO_CARD_ADDED
  PROMO_CARD_UPDATED
  PROMO_CARD_REMOVED
  PROMO_CARD_REORDERED
  HOMEPAGE_CAROUSEL_CONFIG_SET
  DEPOSIT_CAMPAIGN_CREATED
  DEPOSIT_CAMPAIGN_UPDATED
  DEPOSIT_CAMPAIGN_REMOVED
  PUSH_NOTIFICATION_SENT
  REGISTER_CAMPAIGN_CREATED
  REGISTER_CAMPAIGN_UPDATED
  REGISTER_CAMPAIGN_REMOVED
  LEADERBOARD_CAMPAIGN_CREATED
  LEADERBOARD_CAMPAIGN_UPDATED
  LEADERBOARD_CAMPAIGN_REMOVED
  LEADERBOARD_CAMPAIGN_SCOPES_SET
  LEADERBOARD_CAMPAIGN_REWARD_TIERS_SET
  LEADERBOARD_CAMPAIGN_PRIZES_GRANTED
  MATCH_OF_THE_DAY_ADDED
  MATCH_OF_THE_DAY_UPDATED
  MATCH_OF_THE_DAY_REMOVED
  MATCH_OF_THE_DAY_REORDERED
  TOP_NAV_ITEM_ADDED
  TOP_NAV_ITEM_UPDATED
  TOP_NAV_ITEM_REMOVED
  TOP_NAV_ITEM_REORDERED
}

enum FreebetStatus {
  ACTIVE
  SPENT
  VOIDED
}

/**
 * Where a freebet grant came from - MANUAL is a staff-initiated grant (see
 * FreebetService.grant / the backoffice freebets page); ACCA_ROLLBACK and
 * INSURANCE_BET are the system-granted rewards those promotions issue on a
 * qualifying loss; BET_AND_GET is a BetAndGetCampaign reward (see
 * FreebetGrant.sourceCampaignId for which one).
 */
enum FreebetSource {
  MANUAL
  ACCA_ROLLBACK
  INSURANCE_BET
  BET_AND_GET
  DEPOSIT_CAMPAIGN
  REGISTER_CAMPAIGN
  LEADERBOARD_CAMPAIGN
}

/**
 * One freebet grant - a credit toward the player's pooled freebets balance
 * (see FreebetService.balanceCents), not a single-use fixed-value token.
 * Whether a winning bet's stake is credited back on top of net winnings is
 * a per-brand choice (Brand.freebetStakeReturnedOnWin), not a property of
 * the grant itself. A bet can draw any typed stake from that pool,
 * potentially spanning several grants (see BetFreebetDebit) -
 * `remainingCents` tracks how much of this specific grant hasn't been
 * drawn down yet, starting equal to `amountCents`. `status` flips to
 * SPENT once `remainingCents` reaches 0, or VOIDED via an explicit staff
 * action - expiry is a read-time condition on expiresAt, not a swept
 * status, since there's no background job infrastructure in this
 * codebase to transition it otherwise.
 */
model FreebetGrant {
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId              String
  brand                Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  amountCents          Int
  /**
   * How much of amountCents hasn't been drawn down by a BetFreebetDebit yet - starts equal to amountCents.
   */
  remainingCents       Int
  source               FreebetSource
  /**
   * Staff-entered free text for a MANUAL grant, e.g. "Goodwill gesture - support ticket #482". Null for system-granted sources.
   */
  note                 String?
  status               FreebetStatus @default(ACTIVE)
  expiresAt            DateTime?
  /**
   * When remainingCents first reached 0 - i.e. when this grant was fully drawn down.
   */
  spentAt              DateTime?
  /**
   * When the freebet-credited modal was shown to (and acknowledged by) the
   * player - null means still pending. Set on next login/app-open even if
   * the grant happened while the player wasn't logged in at all, unlike the
   * frontend's own same-session localStorage tracking which only survives a
   * PWA reload, not a real gap in being logged in.
   */
  notifiedAt           DateTime?
  /**
   * The bet that triggered a system grant (e.g. the losing accumulator an ACCA_ROLLBACK reward refunds) - null for MANUAL grants. Also doubles as the idempotency key so re-settling a bet never grants the reward twice.
   */
  sourceBetId          String?
  /**
   * Which BetAndGetCampaign granted this - only set when source is BET_AND_GET, used to count a player's redemptions of that specific campaign against its maxRedemptionsPerPlayer.
   */
  sourceCampaignId     String?
  voidedAt             DateTime?
  /**
   * Denormalized actor snapshot, same pattern as AuditLogEntry - null for a system-granted (non-MANUAL) source.
   */
  createdByStaffUserId String?
  createdByUsername    String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  debits BetFreebetDebit[]

  @@index([userId, status])
  @@index([brandId])
  @@index([sourceBetId])
  @@index([sourceCampaignId])
  @@map("freebet_grants")
}

/**
 * One grant's contribution toward funding one freebet-mode bet - a bet's
 * stake can draw from several grants at once (see
 * FreebetService.spendFromBalance), so this is a many-to-many join between
 * Bet and FreebetGrant rather than a single FK on either side.
 */
model BetFreebetDebit {
  id             String       @id @default(uuid())
  betId          String
  bet            Bet          @relation(fields: [betId], references: [id], onDelete: Cascade)
  freebetGrantId String
  freebetGrant   FreebetGrant @relation(fields: [freebetGrantId], references: [id], onDelete: Cascade)
  amountCents    Int
  createdAt      DateTime     @default(now())

  @@index([betId])
  @@index([freebetGrantId])
  @@map("bet_freebet_debits")
}

/**
 * Staff-configurable "how important is this competition" ranking, used to
 * sort the sport page's "most important first" view - see
 * apps/odds-engine's competition field on Match (matches
 * the-odds-api.com's sport_title verbatim, e.g. "EPL", "La Liga - Spain").
 * Lower rank = shown first. A competition with no row here sorts after
 * every ranked one (see CompetitionRankingService.rankFor).
 */
model CompetitionRanking {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competition String
  rank        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, competition])
  @@index([brandId])
  @@map("competition_rankings")
}

/**
 * Staff-curated cross-sport shortcut list for the sidebar's "Top
 * Competitions" section - deliberately a separate model from
 * CompetitionRanking. CompetitionRanking orders each sport's own
 * competitions independently for that sport's drill-down; Quicklinks is
 * a single hand-picked ordered list that can mix competitions from any
 * sport (e.g. EPL, Champions League, ATP Finals in one list) for the
 * player-facing sidebar shortcut section. Lower order = shown first.
 */
model CompetitionQuicklink {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competition String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, competition])
  @@index([brandId])
  @@map("competition_quicklinks")
}

/**
 * Which "who can see this" rule a targeted piece of content (manual
 * market, boost, CMS content) uses. SEGMENTS means the viewer must belong
 * to at least one of the content's assigned PlayerSegments - see
 * audience.ts's resolveAudience for the actual check. LOGGED_OUT/
 * LOGGED_IN read the viewer's auth state, resolved softly (no login
 * required to browse) by OptionalPlayerAuthService.
 */
enum AudienceMode {
  ALL
  LOGGED_OUT
  LOGGED_IN
  SEGMENTS
}

/**
 * Staff-curated player groupings for targeting manual markets, boosts,
 * and (future) CMS content to a subset of players - the "CRM segment"
 * referenced throughout trading/CMS tooling. Membership is manual for
 * now (add/remove a player by email or username in the backoffice); rule-
 * based/automatic membership is a later CRM-module concern, not built here.
 */
model PlayerSegment {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /**
   * Staff-set swatch (e.g. "#EF0107") so the backoffice can show a colored circle next to each segment - purely a CRM organizing aid, no player-facing effect. Null until a staff member sets one.
   */
  colorHex    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members              PlayerSegmentMember[]
  manualMarkets        ManualMarketSegment[]
  boosts               BoostSegment[]
  depositCampaigns     DepositCampaignSegment[]
  betAndGetCampaigns   BetAndGetCampaignSegment[]
  registerCampaigns    RegisterCampaignSegment[]
  leaderboardCampaigns LeaderboardCampaignSegment[]
  pushNotifications    PushNotificationSegment[]

  @@unique([brandId, name])
  @@index([brandId])
  @@map("player_segments")
}

model PlayerSegmentMember {
  id        String        @id @default(uuid())
  segmentId String
  segment   PlayerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime      @default(now())

  @@unique([segmentId, userId])
  @@index([userId])
  @@map("player_segment_members")
}

/**
 * Which pricing tier a competition falls into (1-4) - set by trading per
 * brand, since two operators running the same feed may want to price the
 * same competition differently. A competition with no row here has no
 * tier, so MarginConfig never applies to it (raw feed odds pass through
 * unchanged) - never guessed to a default tier.
 */
model CompetitionTier {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competition String
  tier        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, competition])
  @@index([brandId])
  @@map("competition_tiers")
}

enum LimitScope {
  GLOBAL
  SPORT
  COUNTRY
  LEAGUE
  MARKET
  /**
   * Targets one specific player (scopeValue = that player's User.id) - the most specific possible scope, overriding whatever the market/league/sport/global cascade would otherwise say for their bets. See stake-limits.ts's player-aware resolution.
   */
  PLAYER
}

/**
 * Max stake / max liability for one (scope, scopeValue) pairing, optionally
 * narrowed to one CompetitionTier tier (0 = applies regardless of tier).
 * scopeValue is "" for GLOBAL (the brand-wide default) and otherwise the
 * raw feed sport/country/competition/market name, same convention as
 * CompetitionTier/CompetitionRanking - matches are never persisted, so
 * there's no id to key on.
 * A bet resolves its effective cap per field (maxStakeCents,
 * maxLiabilityCents) independently by walking MARKET -> LEAGUE -> COUNTRY
 * -> SPORT -> GLOBAL, tier-specific before tier-agnostic at each level, and
 * taking the first non-null value found - the same "most specific wins"
 * cascade a CSS rule uses (see resolveLegLimit in stake-limits.ts). An
 * accumulator resolves every leg's own cap this way, then uses the
 * smallest one across all legs (resolveBetLimit) - a book's real exposure
 * on an accumulator is bounded by whichever leg is most restrictive, not
 * an average or a sum.
 */
model StakeLimit {
  id                String     @id @default(uuid())
  brandId           String
  brand             Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  scope             LimitScope
  scopeValue        String     @default("")
  tier              Int        @default(0)
  maxStakeCents     Int?
  maxLiabilityCents Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([brandId, scope, scopeValue, tier])
  @@index([brandId])
  @@map("stake_limits")
}

/**
 * Margin percent for a given raw feed market name (e.g. "Match Result") at
 * a given tier (1-4) within a given sport, per brand. Applied to every
 * match whose competition is assigned that tier (see CompetitionTier) and
 * whose sport matches - the same market name at the same tier can carry a
 * different margin per sport (e.g. Football's Match Result vs Tennis's),
 * since "Match Result" isn't a single fungible market across sports. A
 * (sport, tier, marketName) triple with no row here means no margin is
 * applied to that market, same "nothing fabricated" rule as CompetitionTier.
 */
model MarginConfig {
  id            String   @id @default(uuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sport         String
  marketName    String
  tier          Int
  marginPercent Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([brandId, sport, marketName, tier])
  @@index([brandId])
  @@map("margin_configs")
}

/**
 * A manual log of marketing spend, entered by an admin - there's no ad-
 * platform integration yet, so this is deliberately just a ledger an
 * admin fills in by hand. Denormalizes the creating staff member's
 * username (like AuditLogEntry does) rather than a StaffUser FK, so the
 * row still reads sensibly if that staff account is later removed.
 */
model MarketingSpend {
  id                   String   @id @default(uuid())
  brandId              String
  brand                Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  date                 DateTime
  channel              String
  amountCents          Int
  createdByStaffUserId String?
  createdByUsername    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([brandId, date])
  @@map("marketing_spend")
}

/**
 * A real sports team's own brand color - not brand-scoped like
 * CompetitionRanking above, since a team's color doesn't change per
 * operator (Arsenal is the same red everywhere). Rows get created two
 * ways: (1) any staff backoffice can "sync" team names it sees in the odds
 * feed, which inserts new names with colorHex left null, or (2) an admin
 * sets/edits colorHex directly. colorHex is only ever null until a human
 * (or the startup seed of well-known teams) sets it - never guessed.
 */
model TeamColor {
  id        String   @id @default(uuid())
  name      String   @unique
  colorHex  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_colors")
}

enum DisplayNameEntityType {
  SPORT
  COUNTRY
  COMPETITION
  TEAM
  MARKET
  SELECTION
}

/**
 * A nicer label for a raw feed name - e.g. the-odds-api.com's verbose
 * "UEFA Champions League Qualification" shown to players as "UEFA
 * Champions League (Q)" instead. Not brand-scoped or locale-specific (one
 * override, same for every brand and every player) - see the backoffice
 * conversation that asked for this: a single rename, not multi-language
 * i18n. Rows get created the same two ways as TeamColor above: synced from
 * the feed with displayName left null, or set directly by an admin.
 * MARKET/SELECTION cover market names (e.g. "Match Result") and outcome
 * names (e.g. "Home"/"Draw"/"Away") the same way.
 */
model DisplayNameOverride {
  id          String                @id @default(uuid())
  entityType  DisplayNameEntityType
  rawName     String
  displayName String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([entityType, rawName])
  @@map("display_name_overrides")
}

/**
 * Deliberately no FK relation to StaffUser - actor identity is a
 * denormalized snapshot (id + username) so an audit entry survives even
 * if the acting staff account is later deleted. brandId IS a real FK
 * (Brand deletion isn't supported yet, and unlike a staff account, a
 * brand disappearing should take its audit trail with it).
 */
model AuditLogEntry {
  id               String      @id @default(uuid())
  actorStaffUserId String?
  actorUsername    String
  action           AuditAction
  targetType       String
  targetId         String
  metadata         Json?
  createdAt        DateTime    @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([createdAt])
  @@map("audit_log_entries")
}

enum AnalyticsEventType {
  PAGE_VIEW
  SEARCH
  CLICK
  LOGIN
  BET_PLACED
  BET_NOT_FINISHED
}

/**
 * Deliberately no FK relation to User - same reasoning as AuditLogEntry's
 * actor fields: events must survive account deletion, and most events are
 * anonymous (userId null) since visitors are tracked before they ever log
 * in. sessionId is a client-generated anonymous id (kept even after
 * login, so a single browsing session can be traced end to end regardless
 * of auth state).
 */
model AnalyticsEvent {
  id        String             @id @default(uuid())
  type      AnalyticsEventType
  path      String?
  sessionId String
  userId    String?
  metadata  Json?
  createdAt DateTime           @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, type, createdAt])
  @@index([brandId, userId, createdAt])
  @@map("analytics_events")
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

enum SelectionStatus {
  OPEN
  WON
  LOST
  VOID
}

/**
 * One combined-odds bet, made up of one or more selections (a single bet has exactly one).
 * brandId is denormalized from user.brandId at creation time (rather than
 * joined through User on every query) so bet-listing/reporting queries
 * can filter directly without a join - a player never moves brands, so
 * this can't drift.
 */
model Bet {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId              String
  brand                Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  stakeCents           Int
  combinedOdds         Decimal   @db.Decimal(10, 4)
  potentialPayoutCents Int
  /**
   * The acca boost percent (see AccaBoostConfig) actually applied at placement time - 0 for a single bet or an accumulator that didn't qualify. Stored on the bet, not recomputed later, so a config change never retroactively changes a bet already placed.
   */
  accaBoostPercent     Float     @default(0)
  /**
   * The insurance premium percent (see InsuranceBetConfig) actually deducted from the payout at placement time - 0 when the player didn't opt in or the feature was off. A non-zero value here is also what settlement checks to decide whether a loss refunds the stake as a freebet.
   */
  insuranceCostPercent Float     @default(0)
  status               BetStatus @default(PENDING)
  createdAt            DateTime  @default(now())

  /**
   * Null until every selection is settled (or the bet is LOST outright).
   */
  settledPayoutCents Int?
  settledAt          DateTime?
  /**
   * When the win-celebration modal was shown to (and acknowledged by) the
   * player for this bet settling WON - null means still pending. Only ever
   * set for a WON bet. Set on next login/app-open even if settlement
   * happened while the player wasn't logged in at all - the frontend's own
   * same-session localStorage tracking only survives a PWA reload, not a
   * real gap in being logged in.
   */
  winNotifiedAt      DateTime?

  /**
   * True when this bet was funded from the player's pooled freebets balance
   * instead of cash (see FreebetService.spendFromBalance) - the typed stake
   * can draw from one or several grants, tracked per-grant in
   * freebetDebits. Settlement never returns the stake for a freebet-funded
   * bet, only the profit (see PamService.settleSelection).
   */
  fundedByFreebets Boolean           @default(false)
  freebetDebits    BetFreebetDebit[]

  /**
   * The single BetAndGetCampaign this bet qualified for, resolved once at placement time from the live match/odds data then reused unchanged at settlement (see PamService) - never re-derived later, so a scope/condition change never retroactively relabels an already-placed bet. Null when no campaign applied.
   */
  betAndGetCampaignId String?
  betAndGetCampaign   BetAndGetCampaign? @relation(fields: [betAndGetCampaignId], references: [id], onDelete: SetNull)

  /**
   * The DepositCampaignRedemption this bet fulfilled the bet-requirement for, if any (its own depositCampaignId points at the campaign) - same "resolved once at placement, reused unchanged at settlement" rule as betAndGetCampaignId.
   */
  depositCampaignRedemptionId String?                    @unique
  depositCampaignRedemption   DepositCampaignRedemption? @relation(fields: [depositCampaignRedemptionId], references: [id], onDelete: SetNull)

  /**
   * The RegisterCampaignRedemption this bet fulfilled the qualifying-bet requirement for, if any - same "resolved once at placement, reused unchanged at settlement" rule as betAndGetCampaignId/depositCampaignRedemptionId.
   */
  registerCampaignRedemptionId String?                     @unique
  registerCampaignRedemption   RegisterCampaignRedemption? @relation(fields: [registerCampaignRedemptionId], references: [id], onDelete: SetNull)

  selections           BetSelection[]
  leaderboardEntryBets LeaderboardEntryBet[]

  @@index([userId])
  @@index([brandId])
  @@index([betAndGetCampaignId])
  @@map("bets")
}

/**
 * Blocks new bets on a match (marketId = ""), one whole market (selectionId
 * = ""), or one specific selection within a market. The odds-engine itself
 * is a stateless read-through proxy over the live feed with no persistence
 * of its own - this is our own DB's record of what trading has locked,
 * checked by PamService.placeBet. Scoped per brand: the same externally-
 * sourced matchId is shared across all brands (one global odds feed), but
 * suspending it is each brand's own trading decision, independent of every
 * other brand's. See also CompetitionSuspension for the coarser "suspend
 * every match in this competition" case, which isn't expressible here
 * since matches themselves are never persisted.
 */
model MarketSuspension {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId     String
  marketId    String   @default("")
  selectionId String   @default("")
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([brandId, matchId, marketId, selectionId])
  @@index([brandId, matchId])
  @@map("market_suspensions")
}

/**
 * Blocks new bets on every match in a named competition, for one brand.
 * Keyed on the competition's raw feed name (matches Match.competition
 * verbatim, e.g. "EPL") rather than an id, since matches/competitions are
 * never persisted - same convention as CompetitionRanking/CompetitionTier.
 */
model CompetitionSuspension {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competition String
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([brandId, competition])
  @@index([brandId])
  @@map("competition_suspensions")
}

/**
 * A trader's manual fixed price for one selection, applied to
 * PublicMatchesController's response after MarginPricingService - takes
 * the final price straight to oddsValue, bypassing the tier/margin
 * calculation entirely for that selection (not a modifier on top of it).
 * Keyed on matchId/marketId/selectionId same as MarketSuspension, since
 * matches are never persisted; scoped per brand like every other trading
 * tool here.
 */
model OddsOverride {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId     String
  marketId    String
  selectionId String
  oddsValue   Float
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, matchId, marketId, selectionId])
  @@index([brandId, matchId])
  @@map("odds_overrides")
}

/**
 * A trader-created market that doesn't exist in the odds feed at all -
 * merged into PublicMatchesController's response as an extra entry in
 * match.markets alongside the feed's own markets. Its selections carry
 * whatever price the trader set directly (no margin pipeline involvement -
 * there's no feed price to apply a margin to). Deleting the market cascades
 * to its selections; editing replaces the name and the whole selection list
 * in one write rather than patching individual selections.
 */
model ManualMarket {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId   String
  name      String
  createdAt DateTime @default(now())

  /**
   * Per-bet cap on a single selection in this market; a bet over this amount is rejected, not silently capped.
   */
  maxStakeCents         Int?
  /**
   * Cap on total exposure across all bets placed on this market. Unlike a
   * boost's maxLiabilityCents, hitting this doesn't remove the market -
   * it's enforced the same way as maxStakeCents: a bet that would push
   * total liability past the cap is rejected outright.
   */
  maxLiabilityCents     Int?
  /**
   * Running total of potential payout across bets placed on this market so far - see PamService's liability tracking.
   */
  currentLiabilityCents Int          @default(0)
  /**
   * Who can see this market at all - see AudienceMode. Defaults to everyone, same as before this field existed.
   */
  audienceMode          AudienceMode @default(ALL)
  /**
   * Set once currentLiabilityCents reaches maxLiabilityCents - mergeIntoMatches skips a disabled market, same as if it never existed. Not deleted, so the exposure history stays on the row.
   */
  disabledAt            DateTime?
  /**
   * A manually-priced market has no live re-pricing feed behind it, so it auto-suspends the moment its match goes in-play unless a trader explicitly marks it safe to keep offering live. Defaults to false (auto-suspend), same as every market before this field existed.
   */
  staysLiveDuringInplay Boolean      @default(false)
  /**
   * A novelty/special market a trader doesn't want combined into an accumulator with other legs (correlation risk a manual price can't account for) - a bet with 2+ selections that includes one of these is rejected outright, same enforcement PamService already gives boosts. Defaults to false - unrestricted, same as every market before this field existed.
   */
  singlesOnly           Boolean      @default(false)

  selections       ManualMarketSelection[]
  audienceSegments ManualMarketSegment[]

  @@index([brandId, matchId])
  @@map("manual_markets")
}

model ManualMarketSegment {
  id             String        @id @default(uuid())
  manualMarketId String
  manualMarket   ManualMarket  @relation(fields: [manualMarketId], references: [id], onDelete: Cascade)
  segmentId      String
  segment        PlayerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([manualMarketId, segmentId])
  @@map("manual_market_segments")
}

model ManualMarketSelection {
  id             String       @id @default(uuid())
  manualMarketId String
  manualMarket   ManualMarket @relation(fields: [manualMarketId], references: [id], onDelete: Cascade)
  name           String
  odds           Float
  createdAt      DateTime     @default(now())

  @@map("manual_market_selections")
}

/**
 * One rung of a brand's price grid - the only decimal odds a boosted price
 * is ever allowed to land on (see BoostService.applyBoosts / odds-ladder.ts).
 * Seeded per brand via OddsLadderService.regenerateStandard (the real
 * industry-standard tick ladder), then freely added to/removed from by
 * trading. Not tied to any one match/market - one grid covers every
 * selection a brand ever boosts.
 */
model OddsLadderRung {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  value     Float
  createdAt DateTime @default(now())

  @@unique([brandId, value])
  @@index([brandId])
  @@map("odds_ladder_rungs")
}

/**
 * A trader-configured price boost on one selection: instead of a fixed
 * price (see OddsOverride), this stores how many rungs to climb the
 * brand's OddsLadderRung grid from whatever price the selection would
 * otherwise show - applied as the last step of the public matches pricing
 * pipeline, after margin, manual markets, and overrides, so "the price it
 * would otherwise show" already accounts for all of those. Upsert-keyed
 * like MarketSuspension/OddsOverride, so re-setting a boost on the same
 * selection edits it in place rather than duplicating.
 */
model Boost {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId     String
  marketId    String
  selectionId String
  ticks       Int
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /**
   * Per-bet cap on the boosted selection - shown to players alongside the boosted price, enforced (rejected, not capped) at placement.
   */
  maxStakeCents         Int?
  /**
   * Total extra payout (boosted odds minus original odds, times stake) this boost may give away before it auto-disables. Null means unlimited.
   */
  maxLiabilityCents     Int?
  /**
   * Running total of extra payout given away by bets placed at the boosted price so far - see PamService's liability tracking.
   */
  currentLiabilityCents Int          @default(0)
  /**
   * Set once currentLiabilityCents reaches maxLiabilityCents - applyBoosts skips a disabled boost, same as if it never existed. Not deleted, so the exposure history stays on the row.
   */
  disabledAt            DateTime?
  /**
   * Who can see this boosted price at all - see AudienceMode. Defaults to everyone, same as before this field existed.
   */
  audienceMode          AudienceMode @default(ALL)
  /**
   * A boosted price has no live re-pricing behind the boost itself, so it auto-suspends the moment its match goes in-play unless a trader explicitly marks it safe to keep offering live. Defaults to false (auto-suspend), same as every boost before this field existed.
   */
  staysLiveDuringInplay Boolean      @default(false)

  audienceSegments BoostSegment[]

  @@unique([brandId, matchId, marketId, selectionId])
  @@index([brandId, matchId])
  @@map("boosts")
}

model BoostSegment {
  id        String        @id @default(uuid())
  boostId   String
  boost     Boost         @relation(fields: [boostId], references: [id], onDelete: Cascade)
  segmentId String
  segment   PlayerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([boostId, segmentId])
  @@map("boost_segments")
}

/**
 * A brand's accumulator-boost settings - a single row per brand (never
 * created explicitly; AccaBoostService.getConfig returns sane defaults
 * when none exists yet, same "nothing fabricated until a human sets it"
 * rule as the rest of trading, except here the fallback is "boost off"
 * rather than "no data"). boostPercentPerLeg is added once per selection
 * in a qualifying accumulator (see acca-boost.ts's calculateAccaBoost) -
 * not a flat bonus, not compounding.
 */
model AccaBoostConfig {
  id                 String   @id @default(uuid())
  brandId            String   @unique
  brand              Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  boostPercentPerLeg Float    @default(5)
  minSelections      Int      @default(3)
  minOddsPerLeg      Float    @default(1.2)
  enabled            Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  @@map("acca_boost_configs")
}

/**
 * A brand's accumulator-rollback settings - a single row per brand (same
 * "no row = feature off" default pattern as AccaBoostConfig). When a
 * qualifying accumulator (>= minSelections legs) loses by no more than
 * lossThreshold legs, rewardPercent of the stake is refunded as a freebet
 * (FreebetSource.ACCA_ROLLBACK). Evaluated at settlement time once every
 * leg is terminal - see PamService.settleSelection.
 */
model AccaRollbackConfig {
  id            String   @id @default(uuid())
  brandId       String   @unique
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  minSelections Int      @default(3)
  lossThreshold Int      @default(1)
  rewardPercent Float    @default(100)
  enabled       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("acca_rollback_configs")
}

/**
 * A brand's insurance-bet settings - a single row per brand (same "no row =
 * feature off" default pattern as AccaBoostConfig/AccaRollbackConfig).
 * When a player opts in at placement (any bet - single or accumulator),
 * costPercent is deducted from the potential payout up front as the
 * premium; if the bet then loses at all, the stake comes back as a
 * freebet (FreebetSource.INSURANCE_BET) - see insurance-bet.ts and
 * PamService.
 */
model InsuranceBetConfig {
  id          String   @id @default(uuid())
  brandId     String   @unique
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  costPercent Float    @default(10)
  enabled     Boolean  @default(false)
  /**
   * Insurance only ever applies to a bet whose combined odds are at least
   * this - below it, the bet slip never offers the opt-in, and the backend
   * rejects a request that tries to opt in anyway (see
   * PamService.assertInsuranceEligible). Defaults to 1 (i.e. no real
   * floor, since combined odds are always >= 1.01 in practice), matching
   * every deployment's actual behavior before this field existed.
   */
  minOdds     Float    @default(1)
  updatedAt   DateTime @updatedAt

  @@map("insurance_bet_configs")
}

/**
 * When the reward fires - immediately when a qualifying bet is placed, or once it settles (see the three triggerOnX flags on BetAndGetCampaign for which settlement outcomes count).
 */
enum BetAndGetTrigger {
  PLACEMENT
  SETTLEMENT
}

enum BetAndGetBetType {
  SINGLES_ONLY
  ACCUMULATOR_ONLY
  EITHER
}

/**
 * Restricts which selections' matches can qualify by whether the match had
 * kicked off yet at bet placement - PREMATCH_ONLY/INPLAY_ONLY reject a bet
 * the instant any one of its selections is on the wrong side, ACCUMULATOR
 * combinations of prematch+live legs never qualify unless EITHER is set.
 */
enum BetAndGetTiming {
  PREMATCH_ONLY
  INPLAY_ONLY
  EITHER
}

/**
 * What kind of thing a BetAndGetCampaignScope entry names - see BetAndGetCampaignScope.scopeValue for what's stored per type.
 */
enum BetAndGetScopeType {
  SPORT
  COMPETITION
  MATCH
}

/**
 * FIXED = same rewardAmountCents every time; PERCENTAGE = rewardPercent of the qualifying bet's own stake, capped at rewardCapCents.
 */
enum BetAndGetRewardType {
  FIXED
  PERCENTAGE
}

/**
 * "Bet & Get" campaign - a trader-scoped promo (one or more
 * sports/competitions/matches, see BetAndGetCampaignScope) that grants a
 * freebet, either a flat amount or a percentage of the qualifying bet's
 * stake (see BetAndGetRewardType), to a player whose bet meets the
 * configured conditions. Accumulated-across-bets variants are a later,
 * separate build, not a field on this model.
 */
model BetAndGetCampaign {
  id          String    @id @default(uuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  enabled     Boolean   @default(false)
  /**
   * Optional scheduling window, both independently optional - a campaign is
   * only actually live when enabled AND (no startAt or startAt has passed)
   * AND (no endAt or endAt hasn't passed yet). See isCampaignScheduledActive.
   */
  startAt     DateTime?
  endAt       DateTime?

  /**
   * FIXED always pays the same rewardAmountCents; PERCENTAGE pays a share
   * of the qualifying bet's own stake, capped so a very large stake can't
   * produce an unbounded reward - same shape as DepositCampaign's reward
   * fields, kept as a distinct enum since it's semantically "reward from a
   * bet" not "reward from a deposit".
   */
  rewardType        BetAndGetRewardType @default(FIXED)
  /**
   * Required when rewardType is FIXED, ignored otherwise.
   */
  rewardAmountCents Int?
  /**
   * Required when rewardType is PERCENTAGE (e.g. 10 = 10% of the stake), ignored otherwise.
   */
  rewardPercent     Float?
  /**
   * Required when rewardType is PERCENTAGE - the max freebet the percentage can produce.
   */
  rewardCapCents    Int?

  trigger       BetAndGetTrigger @default(PLACEMENT)
  /**
   * Only meaningful when trigger is SETTLEMENT - at least one should be true, checked by the service layer, not the DB.
   */
  triggerOnWon  Boolean          @default(false)
  triggerOnLost Boolean          @default(false)
  triggerOnVoid Boolean          @default(false)

  /**
   * All five qualifying-condition fields are optional independently - null means that condition doesn't restrict anything.
   */
  minStakeCents   Int?
  /**
   * Every leg's own odds must be at least this - same convention as AccaBoostConfig.minOddsPerLeg.
   */
  minOddsPerLeg   Float?
  /**
   * The accumulator's combined price (product of all legs' odds) must be at
   * least this - distinct from minOddsPerLeg, which checks each leg
   * individually. A "treble at 3.00" promo needs this, not a per-leg floor.
   */
  minCombinedOdds Float?
  betType         BetAndGetBetType @default(EITHER)
  /**
   * Only checked when the bet is an accumulator (2+ selections).
   */
  minSelections   Int?
  /**
   * Whether a qualifying selection's match must be prematch, already live,
   * or either - see BetAndGetTiming. Also drives which matches the
   * campaign's own matches list/match-page banner show as eligible.
   */
  bettingTiming   BetAndGetTiming  @default(EITHER)

  /**
   * false = at most one redemption ever per player for this campaign. When true, maxRedemptionsPerPlayer caps it further (null = unlimited).
   */
  allowMultipleRedemptions Boolean @default(false)
  maxRedemptionsPerPlayer  Int?

  /**
   * Who this campaign (and its auto-managed promo card, see PromoCard) is
   * shown/available to - same pattern as Boost/ManualMarket/DepositCampaign
   * audience targeting.
   */
  audienceMode AudienceMode               @default(ALL)
  segments     BetAndGetCampaignSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopes            BetAndGetCampaignScope[]
  bets              Bet[]
  /**
   * CMS-managed cards (homepage/Challenges page) that link to this campaign - see PromoCard. A campaign can have zero, one, or several pointing at it.
   */
  promoCards        PromoCard[]
  pushNotifications PushNotification[]

  @@index([brandId])
  @@map("bet_and_get_campaigns")
}

model BetAndGetCampaignSegment {
  id         String            @id @default(uuid())
  campaignId String
  campaign   BetAndGetCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  segmentId  String
  segment    PlayerSegment     @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([campaignId, segmentId])
  @@map("bet_and_get_campaign_segments")
}

/**
 * One eligibility entry for a campaign - a campaign's full match scope is
 * the union of every one of its scope rows (e.g. "all of Sport X" OR "all
 * of Competition Y" OR "this one specific Match Z"). scopeValue holds the
 * raw feed sport/competition name for those two types, or a matchId for
 * MATCH - matches are never persisted, so there's no id to join on the way
 * CompetitionTier/StakeLimit already work by raw name.
 */
model BetAndGetCampaignScope {
  id         String             @id @default(uuid())
  campaignId String
  campaign   BetAndGetCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scopeType  BetAndGetScopeType
  scopeValue String

  @@index([campaignId])
  @@map("bet_and_get_campaign_scopes")
}

/**
 * A CMS-managed promotional card - shown on the homepage and/or the
 * Challenges page (apps/frontend), byte-stored like BrandImage. Optionally
 * links to a BetAndGetCampaign (clicking takes the player straight to that
 * campaign's scoped matches) or a DepositCampaign (clicking reopens the
 * deposit campaign modal) - never both at once, enforced by the service
 * layer, not the DB. A card with no link is purely decorative and never
 * auto-managed. sortOrder is staff-controlled, same drag-reorder convention
 * as BrandImageListItem/CompetitionRanking.
 * data/mimeType are optional: a card auto-created for a campaign that has
 * no staff-uploaded image yet (see PromoCardService.ensureAutoCardForCampaign)
 * has neither, and the frontend renders it as a short brand-color banner
 * instead of a photo. autoCreated distinguishes those system-managed rows
 * from ones a staff member deliberately created, so the sync logic never
 * touches/duplicates a staff member's own card. Both campaign relations
 * cascade-delete their card - a deleted campaign's promo (auto or manual,
 * with or without an image) should stop existing, not just unlink.
 */
model PromoCard {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  data        Bytes?
  mimeType    String?
  title       String?
  subtitle    String?
  sortOrder   Int
  autoCreated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  betAndGetCampaignId String?
  betAndGetCampaign   BetAndGetCampaign? @relation(fields: [betAndGetCampaignId], references: [id], onDelete: Cascade)

  depositCampaignId String?
  depositCampaign   DepositCampaign? @relation(fields: [depositCampaignId], references: [id], onDelete: Cascade)

  registerCampaignId String?
  registerCampaign   RegisterCampaign? @relation(fields: [registerCampaignId], references: [id], onDelete: Cascade)

  leaderboardCampaignId String?
  leaderboardCampaign   LeaderboardCampaign? @relation(fields: [leaderboardCampaignId], references: [id], onDelete: Cascade)

  @@index([brandId, sortOrder])
  @@map("promo_cards")
}

enum DepositRewardType {
  FIXED
  PERCENTAGE
}

enum DepositCampaignRedemptionStatus {
  /**
   * Deposit qualified, still waiting on a bet that meets the campaign's conditions - eligible to be matched by the next qualifying bet.
   */
  PENDING_BET
  /**
   * A qualifying bet has linked to this redemption (see Bet.depositCampaignRedemptionId) and the campaign's trigger is SETTLEMENT - awaiting that bet's outcome.
   */
  PENDING_SETTLEMENT
  /**
   * The freebet has been granted (immediately for a no-bet-required campaign or a PLACEMENT trigger, or once the linked bet's settlement outcome matched).
   */
  GRANTED
}

/**
 * A deposit-triggered promo: reward is either a flat amount per qualifying
 * deposit (FIXED) or a percentage of the deposit up to a cap (PERCENTAGE).
 * Optionally also requires a subsequent bet to meet the same
 * trigger/qualifying-condition shape as BetAndGetCampaign (requiresBet) -
 * when false the reward grants the instant a qualifying deposit is made.
 * Shown to the player as a modal right after login (see the public
 * eligible-for-me endpoint) and/or via a linked PromoCard.
 */
model DepositCampaign {
  id          String    @id @default(uuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  enabled     Boolean   @default(false)
  /**
   * Same optional scheduling window as BetAndGetCampaign - see isCampaignScheduledActive.
   */
  startAt     DateTime?
  endAt       DateTime?

  minDepositAmountCents Int

  rewardType             DepositRewardType
  /**
   * Required when rewardType is FIXED, ignored otherwise.
   */
  fixedRewardAmountCents Int?
  /**
   * Required when rewardType is PERCENTAGE (e.g. 50 = 50%), ignored otherwise.
   */
  rewardPercent          Float?
  /**
   * Required when rewardType is PERCENTAGE - the max freebet the percentage can produce.
   */
  rewardCapCents         Int?

  requiresBet   Boolean          @default(false)
  /**
   * Only meaningful when requiresBet is true.
   */
  trigger       BetAndGetTrigger @default(PLACEMENT)
  /**
   * Only meaningful when requiresBet and trigger are SETTLEMENT - at least one should be true, checked by the service layer, not the DB.
   */
  triggerOnWon  Boolean          @default(false)
  triggerOnLost Boolean          @default(false)
  triggerOnVoid Boolean          @default(false)
  /**
   * All four qualifying-condition fields are optional independently, same convention as BetAndGetCampaign - only meaningful when requiresBet is true.
   */
  minStakeCents Int?
  minOddsPerLeg Float?
  betType       BetAndGetBetType @default(EITHER)
  minSelections Int?

  /**
   * false = at most one redemption ever per player for this campaign. When true, maxRedemptionsPerPlayer caps it further (null = unlimited).
   */
  allowMultipleRedemptions Boolean @default(false)
  maxRedemptionsPerPlayer  Int?

  /**
   * Who this campaign is shown/available to - same pattern as Boost/ManualMarket audience targeting.
   */
  audienceMode AudienceMode             @default(ALL)
  segments     DepositCampaignSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions       DepositCampaignRedemption[]
  promoCards        PromoCard[]
  pushNotifications PushNotification[]

  @@index([brandId])
  @@map("deposit_campaigns")
}

model DepositCampaignSegment {
  id                String          @id @default(uuid())
  depositCampaignId String
  depositCampaign   DepositCampaign @relation(fields: [depositCampaignId], references: [id], onDelete: Cascade)
  segmentId         String
  segment           PlayerSegment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([depositCampaignId, segmentId])
  @@map("deposit_campaign_segments")
}

/**
 * One player's real-money (paper-money simulation) top-up - the trigger
 * event a DepositCampaign reacts to. See DepositService.
 */
model Deposit {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime @default(now())

  redemptions DepositCampaignRedemption[]

  @@index([userId])
  @@map("deposits")
}

/**
 * One deposit's progress toward a DepositCampaign's reward - created the
 * instant a qualifying deposit is made (status GRANTED immediately if the
 * campaign doesn't require a bet, otherwise PENDING_BET until a qualifying
 * bet links to it via Bet.depositCampaignRedemptionId). rewardAmountCents
 * is computed once at creation from the deposit amount and never
 * recalculated, so a later campaign edit never retroactively changes an
 * already-qualified deposit's reward.
 */
model DepositCampaignRedemption {
  id                String                          @id @default(uuid())
  depositCampaignId String
  depositCampaign   DepositCampaign                 @relation(fields: [depositCampaignId], references: [id], onDelete: Cascade)
  userId            String
  user              User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId           String
  brand             Brand                           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  depositId         String
  deposit           Deposit                         @relation(fields: [depositId], references: [id], onDelete: Cascade)
  rewardAmountCents Int
  status            DepositCampaignRedemptionStatus @default(PENDING_BET)
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  /**
   * The bet that fulfilled this redemption's bet requirement, if any - see Bet.depositCampaignRedemptionId (the FK lives there, this is just the reverse side).
   */
  fulfillingBet Bet?

  @@index([userId, depositCampaignId])
  @@index([status])
  @@map("deposit_campaign_redemptions")
}

/**
 * A welcome-bonus campaign for new players. Brand-wide, never match-scoped
 * (unlike BetAndGetCampaign) - a register bonus isn't tied to any particular
 * bet's matches, just to the act of signing up (and optionally then placing
 * one qualifying bet). requiresBet mirrors DepositCampaign.requiresBet:
 * false grants the reward the instant registration completes (rewardType
 * must be FIXED then - there's no bet stake yet to take a percentage of);
 * true defers the grant to a qualifying bet placed within
 * qualifyingBetWindowDays of the player's own signup (see
 * RegisterCampaignRedemption, and User.createdAt as the window's start).
 */
model RegisterCampaign {
  id          String    @id @default(uuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  enabled     Boolean   @default(false)
  startAt     DateTime?
  endAt       DateTime?

  rewardType        BetAndGetRewardType @default(FIXED)
  /**
   * Required when rewardType is FIXED, null otherwise.
   */
  rewardAmountCents Int?
  /**
   * Required when rewardType is PERCENTAGE (of the qualifying bet's own stake - only valid alongside requiresBet), null otherwise.
   */
  rewardPercent     Float?
  /**
   * Required when rewardType is PERCENTAGE, null otherwise.
   */
  rewardCapCents    Int?

  requiresBet             Boolean @default(false)
  /**
   * Required when requiresBet is true - the "max days since registration" window a qualifying bet must land within (see isWithinQualifyingBetWindow).
   */
  qualifyingBetWindowDays Int?

  /**
   * Only meaningful when requiresBet is true - same shape as BetAndGetCampaign's trigger/conditions.
   */
  trigger       BetAndGetTrigger @default(PLACEMENT)
  triggerOnWon  Boolean          @default(false)
  triggerOnLost Boolean          @default(false)
  triggerOnVoid Boolean          @default(false)
  minStakeCents Int?
  minOddsPerLeg Float?
  betType       BetAndGetBetType @default(EITHER)
  minSelections Int?

  audienceMode AudienceMode              @default(ALL)
  segments     RegisterCampaignSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions       RegisterCampaignRedemption[]
  promoCards        PromoCard[]
  pushNotifications PushNotification[]

  @@index([brandId])
  @@map("register_campaigns")
}

model RegisterCampaignSegment {
  id                 String           @id @default(uuid())
  registerCampaignId String
  registerCampaign   RegisterCampaign @relation(fields: [registerCampaignId], references: [id], onDelete: Cascade)
  segmentId          String
  segment            PlayerSegment    @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([registerCampaignId, segmentId])
  @@map("register_campaign_segments")
}

/**
 * One player's progress toward a RegisterCampaign's reward - at most one per
 * (campaign, user) ever, since registration is a one-time event (unlike
 * DepositCampaignRedemption, which has no such uniqueness because a player
 * can deposit repeatedly). rewardAmountCents stays null for a
 * requiresBet+PERCENTAGE campaign until the qualifying bet's own stake is
 * known (at its placement or settlement, depending on trigger) - every
 * other combination knows its amount immediately at creation.
 */
model RegisterCampaignRedemption {
  id                 String                          @id @default(uuid())
  registerCampaignId String
  registerCampaign   RegisterCampaign                @relation(fields: [registerCampaignId], references: [id], onDelete: Cascade)
  userId             String
  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId            String
  brand              Brand                           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  rewardAmountCents  Int?
  status             DepositCampaignRedemptionStatus @default(PENDING_BET)
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  /**
   * The bet that fulfilled this redemption's bet requirement, if any - see Bet.registerCampaignRedemptionId (the FK lives there, this is just the reverse side).
   */
  fulfillingBet Bet?

  @@unique([registerCampaignId, userId])
  @@index([status])
  @@map("register_campaign_redemptions")
}

/**
 * A tournament-style campaign: players opt in ("participate"), earn points
 * from qualifying bets per a staff-configured formula (see
 * calculateLeaderboardPoints), and get auto-ranked. endAt is required
 * (unlike every other campaign's optional endAt) - a leaderboard needs a
 * definite end to rank against and grant its prizesGrantedAt-guarded
 * automatic reward tiers.
 */
model LeaderboardCampaign {
  id          String    @id @default(uuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  enabled     Boolean   @default(false)
  startAt     DateTime?
  endAt       DateTime

  /**
   * points = (stakeCents / 100) * pointsPerEuroStaked, optionally further multiplied by the bet's own effective combined odds - see calculateLeaderboardPoints.
   */
  pointsPerEuroStaked         Float   @default(1)
  useCombinedOddsAsMultiplier Boolean @default(false)
  /**
   * true = only bets that settle WON earn points. false = every settled outcome that still qualifies earns points (see leaderboardBetCounts).
   */
  onlySettledWonCounts        Boolean @default(true)

  // Qualifying-bet-spec conditions - identical shape to BetAndGetCampaign's.
  minStakeCents   Int?
  minOddsPerLeg   Float?
  minCombinedOdds Float?
  betType         BetAndGetBetType @default(EITHER)
  minSelections   Int?
  bettingTiming   BetAndGetTiming  @default(EITHER)

  audienceMode AudienceMode                 @default(ALL)
  segments     LeaderboardCampaignSegment[]
  scopes       LeaderboardCampaignScope[]

  /**
   * Null until finalizeIfEnded has run once - the idempotency guard for prize granting (prize grants have no triggering bet, so they can't dedup on FreebetGrant.sourceBetId the way every other system grant does).
   */
  prizesGrantedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries           LeaderboardEntry[]
  rewardTiers       LeaderboardRewardTier[]
  promoCards        PromoCard[]
  pushNotifications PushNotification[]

  @@index([brandId])
  @@map("leaderboard_campaigns")
}

model LeaderboardCampaignSegment {
  id                    String              @id @default(uuid())
  leaderboardCampaignId String
  leaderboardCampaign   LeaderboardCampaign @relation(fields: [leaderboardCampaignId], references: [id], onDelete: Cascade)
  segmentId             String
  segment               PlayerSegment       @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([leaderboardCampaignId, segmentId])
  @@map("leaderboard_campaign_segments")
}

model LeaderboardCampaignScope {
  id                    String              @id @default(uuid())
  leaderboardCampaignId String
  leaderboardCampaign   LeaderboardCampaign @relation(fields: [leaderboardCampaignId], references: [id], onDelete: Cascade)
  scopeType             BetAndGetScopeType
  scopeValue            String

  @@index([leaderboardCampaignId])
  @@map("leaderboard_campaign_scopes")
}

/**
 * A rank (or rank range) -> flat freebet reward, granted automatically once
 * the leaderboard ends (see LeaderboardCampaignService.finalizeIfEnded).
 * Non-overlapping ranges are validated in the service layer, same
 * convention as reward-config validation elsewhere in this codebase.
 */
model LeaderboardRewardTier {
  id                    String              @id @default(uuid())
  leaderboardCampaignId String
  leaderboardCampaign   LeaderboardCampaign @relation(fields: [leaderboardCampaignId], references: [id], onDelete: Cascade)
  rankFrom              Int
  rankTo                Int
  rewardAmountCents     Int
  createdAt             DateTime            @default(now())

  @@unique([leaderboardCampaignId, rankFrom])
  @@index([leaderboardCampaignId])
  @@map("leaderboard_reward_tiers")
}

/**
 * One player's opt-in ("participate") + running point total for a
 * leaderboard. pointsTotal is a cached column, updated by delta (never a
 * blind increment) inside the same settlement transaction that
 * upserts/corrects a LeaderboardEntryBet row below - mirrors exactly how
 * PamService.settleSelection already deltas balanceCents on a settlement
 * correction, so a re-settlement claws back or tops up points instead of
 * double-counting. Ranking is a live `ORDER BY pointsTotal DESC, joinedAt
 * ASC` read (see the index below) rather than a maintained rank column -
 * leaderboard views are far less frequent than bet settlements, so paying
 * the sort cost on read instead of a full re-rank write on every
 * settlement is the right trade.
 */
model LeaderboardEntry {
  id                    String              @id @default(uuid())
  leaderboardCampaignId String
  leaderboardCampaign   LeaderboardCampaign @relation(fields: [leaderboardCampaignId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId               String
  brand                 Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pointsTotal           Int                 @default(0)
  joinedAt              DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  bets LeaderboardEntryBet[]

  @@unique([leaderboardCampaignId, userId])
  @@index([leaderboardCampaignId, pointsTotal])
  @@map("leaderboard_entries")
}

/**
 * One bet's link to one leaderboard entry - created at bet placement (once
 * the bet already qualifies against the campaign's bet spec), then updated
 * in place at settlement with the bet's final point contribution.
 * @@unique(entryId, betId) makes a re-settlement an idempotent upsert
 * instead of a double-count - the same role FreebetGrant.sourceBetId plays
 * for freebets, applied here to a points ledger instead of a cash grant.
 */
model LeaderboardEntryBet {
  id                    String           @id @default(uuid())
  entryId               String
  entry                 LeaderboardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  leaderboardCampaignId String
  betId                 String
  bet                   Bet              @relation(fields: [betId], references: [id], onDelete: Cascade)
  pointsAwarded         Int              @default(0)
  countedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([entryId, betId])
  @@index([leaderboardCampaignId])
  @@map("leaderboard_entry_bets")
}

/**
 * A brand's homepage "Match of the day + Promotions" carousel auto-scroll
 * behavior - same "no row = feature off" default pattern as AccaBoostConfig.
 * Disabled by default until a brand admin turns it on and picks an interval.
 */
model HomepageCarouselConfig {
  id                String   @id @default(uuid())
  brandId           String   @unique
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(false)
  autoScrollSeconds Int      @default(6)
  updatedAt         DateTime @updatedAt

  @@map("homepage_carousel_configs")
}

/**
 * Staff-picked "Match of the day" entries (see the backoffice's CMS Match of
 * the day page) - replaces the old client-side "earliest kickoff with a
 * match-result market" auto-pick entirely. `matchId` is a plain string, not
 * a relation - matches/competitions live in the external odds-engine and
 * are never persisted here (same as Boost.matchId). Scheduling reuses the
 * same enabled+startAt+endAt shape as BetAndGetCampaign/DepositCampaign
 * (see isCampaignScheduledActive) - both bounds independently optional.
 * `sortOrder` is the desired display order when more than one is active at
 * once (see PublicMatchOfTheDayController - apps/frontend shows up to 2
 * side by side on wide desktop viewports, cycling through the rest).
 */
model MatchOfTheDay {
  id        String    @id @default(uuid())
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId   String
  sortOrder Int
  enabled   Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([brandId, sortOrder])
  @@map("match_of_the_day_entries")
}

enum TopNavItemKind {
  SPORT
  COMPETITION
  MATCH
  TODAY
  TOMORROW
}

/**
 * Must stay in sync by hand with TopNavIconKey/TOP_NAV_ICON_KEYS in
 * packages/shared/src/domain/topNavIcons.ts, which owns the actual icon
 * geometry both frontend apps render from - Prisma enums can't import from
 * a TS module, so this list is the DB-side mirror of that one.
 */
enum TopNavIconKey {
  STAR
  FIRE
  TROPHY
  FLAG
  CALENDAR
  CLOCK
  BALL
  BELL
  BOLT
  TARGET
  GLOBE
  MEDAL
  CHART
  HEART
  GRID
  COMPASS
}

/**
 * A second, CMS-managed navbar row (see the backoffice's Top nav page) -
 * staff build it entry by entry from whatever mix of sports, competitions,
 * specific matches, and the two auto-updating "Today"/"Tomorrow" timeframe
 * shortcuts they want, in whatever order they want. Exactly one of
 * sport/competition/matchId is set, matching `kind` - enforced in
 * TopNavItemService, not here, since Prisma has no cross-column check
 * constraint. Same "no local match/competition table" reasoning as
 * MatchOfTheDay - `matchId`/`competition`/`sport` are never validated
 * against a local table, they're just what gets plugged into the player
 * app's own routing (see apps/frontend's SecondaryNavBar); a stale
 * reference (a competition with no more matches, a kicked-off match)
 * simply stops matching anything and silently renders nothing further.
 */
model TopNavItem {
  id          String         @id @default(uuid())
  brandId     String
  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kind        TopNavItemKind
  /**
   * Staff-authored display text - the navbar itself renders icon-only (see
   * SecondaryNavBar), so this is now purely the accessible name (aria-label)
   * and the CMS row's own display title, not shown on the player-facing bar.
   */
  label       String
  /**
   * Freely staff-chosen, independent of `kind` - a COMPETITION entry isn't forced into a trophy, a SPORT entry isn't forced into a ball.
   */
  icon        TopNavIconKey  @default(STAR)
  sport       String?
  competition String?
  matchId     String?
  sortOrder   Int
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([brandId, sortOrder])
  @@map("top_nav_items")
}

/**
 * A snapshot of what was picked at bet time - not a live reference to the
 * odds feed, which has no persistence of its own and can reshuffle/expire.
 */
model BetSelection {
  id            String          @id @default(uuid())
  betId         String
  bet           Bet             @relation(fields: [betId], references: [id], onDelete: Cascade)
  matchId       String
  marketId      String
  selectionId   String
  matchLabel    String
  marketName    String
  selectionName String
  odds          Decimal         @db.Decimal(10, 2)
  status        SelectionStatus @default(OPEN)
  /**
   * Snapshotted from the match's live odds-engine data at placement time
   * (competitions/matches are never persisted - see fetchMatchesByMatchId)
   * so admin reporting can filter by sport/competition. Null on selections
   * placed before this field existed - those simply don't match any
   * sport/competition filter, they aren't backfilled.
   */
  sport         String?
  competition   String?

  @@index([betId])
  @@map("bet_selections")
}

/**
 * A wholly separate identity system from both player auth and staff auth -
 * the single-owner login for the master backoffice (apps/master-backoffice),
 * which creates and configures brands. Own JWT secret so a compromised
 * staff or player token is cryptographically incapable of reaching this,
 * not just logically rejected by a payload check. In practice this table
 * is expected to hold very few rows (often just one).
 */
model MasterUser {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens MasterRefreshToken[]

  @@map("master_users")
}

model MasterRefreshToken {
  id           String     @id @default(uuid())
  masterUserId String
  masterUser   MasterUser @relation(fields: [masterUserId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([masterUserId])
  @@map("master_refresh_tokens")
}

enum ThemeMode {
  LIGHT
  DARK
}

/**
 * Kickoff/match time display - see Brand.timeFormat and apps/frontend's formatKickoff.
 */
enum TimeFormat {
  H12
  H24
}

/**
 * One sportsbook brand under the master product. Every player, staff
 * account, bet, audit entry, and market suspension belongs to exactly
 * one brand - see PROJECT_BRIEF.md Section 10 for the brandId retrofit.
 */
model Brand {
  id                        String     @id @default(uuid())
  name                      String
  /**
   * URL-safe identifier, e.g. for future path-based routing.
   */
  slug                      String     @unique
  /**
   * The domain that resolves to this brand, once domain routing exists.
   */
  domain                    String?    @unique
  /**
   * Resolved public serving paths for the 4 uploadable logo slots (see
   * BrandLogoSlot) - set by BrandsService.setLogo, read back the same way
   * logoUrl always was so apps/frontend just needs a plain <img src>. Site
   * logos render in the header; share logos render on the image generated
   * when a player shares a bet slip. Each has its own light/dark variant
   * since a single logo often reads badly against one of the two
   * backgrounds - which pair renders is decided by the active theme, not
   * themeMode alone (see docs/PROJECT_BRIEF.md: a player's own light/dark
   * choice can override the brand's default at runtime).
   */
  logoLightUrl              String?
  logoDarkUrl               String?
  shareLogoLightUrl         String?
  shareLogoDarkUrl          String?
  /**
   * The deployment's default appearance until a player picks their own (see the account Settings page) - independent of the light/dark color and logo pairs below, which are always both configured regardless of which one is currently active.
   */
  themeMode                 ThemeMode  @default(DARK)
  /**
   * ISO 4217 currency code (e.g. "EUR", "USD", "GBP") this brand's players
   * see everywhere money is shown - stakes, payouts, potential payouts,
   * campaign/insurance before-and-after values, wallet balances. Defaults
   * to EUR, matching every deployment's actual currency before this field
   * existed.
   */
  currencyCode              String     @default("EUR")
  /**
   * Whether match/kickoff times display as 12-hour ("6:30 PM") or 24-hour
   * ("18:30") on the player app - see apps/frontend's formatKickoff.
   */
  timeFormat                TimeFormat @default(H24)
  /**
   * Every brand-configurable color zone (background, surface, button/CTA,
   * highlight, filter, text) is one of these JSON columns, each shaped as
   * { light: ColorValue, dark: ColorValue } where ColorValue is either
   * { type: 'solid', hex } or { type: 'gradient', direction, fromHex, toHex }
   * - see BrandColorZoneDto in modules/master/dto/brand-color.dto.ts for the
   * exact validated shape. Null means "use the fixed built-in default" (see
   * apps/frontend/src/index.css), same fallback behavior the old single-hex
   * fields had. Keeping button/highlight/filter as three distinct zones is
   * deliberate (see docs/PROJECT_BRIEF.md) - a filter or a badge should
   * never visually read as a button. surfaceColor is the base color for
   * elements sitting above the page background (cards, panels, dropdowns -
   * --color-surface) - distinct from background itself, same as every
   * other zone; the derived --color-surface-2/--color-surface-hover shades
   * stay fixed regardless (not independently brand-configurable), same as
   * background's own hover/derived states.
   */
  backgroundColor           Json?
  surfaceColor              Json?
  buttonColor               Json?
  highlightColor            Json?
  filterColor               Json?
  textColor                 Json?
  /**
   * The freebet "F" badge's fill color (see apps/frontend's
   * FreebetBadgeIcon) - the badge's ring/glyph color is always whichever of
   * black/white reads legibly against this fill (see useContrastColor),
   * not independently stored. Null falls back to reusing buttonColor, same
   * as the badge's original hardcoded var(--color-brand) fill.
   */
  freebetBadgeColor         Json?
  /**
   * Shown on the player-facing Responsible Gambling page when set - never a fabricated phone number if left unset.
   */
  supportHelplineText       String?
  /**
   * When a freebet-funded bet wins, whether the stake itself is credited
   * back alongside the net winnings (true - a €10 freebet at odds 9.00
   * pays out the full €90) or withheld like a stake-not-returned free bet
   * (false - the same bet only pays the €80 net winnings). Defaults to
   * true; either way the credited amount always lands in the player's cash
   * balance, never back into their freebets balance (see PamService.settleSelection).
   */
  freebetStakeReturnedOnWin Boolean    @default(true)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  productFlags                BrandProductFlag[]
  users                       User[]
  staffUsers                  StaffUser[]
  bets                        Bet[]
  auditLogEntries             AuditLogEntry[]
  analyticsEvents             AnalyticsEvent[]
  marketSuspensions           MarketSuspension[]
  competitionSuspensions      CompetitionSuspension[]
  competitionRankings         CompetitionRanking[]
  logos                       BrandLogo[]
  images                      BrandImage[]
  imageListItems              BrandImageListItem[]
  competitionTiers            CompetitionTier[]
  marginConfigs               MarginConfig[]
  marketingSpends             MarketingSpend[]
  oddsOverrides               OddsOverride[]
  manualMarkets               ManualMarket[]
  oddsLadderRungs             OddsLadderRung[]
  boosts                      Boost[]
  accaBoostConfig             AccaBoostConfig?
  accaRollbackConfig          AccaRollbackConfig?
  insuranceBetConfig          InsuranceBetConfig?
  stakeLimits                 StakeLimit[]
  competitionQuicklinks       CompetitionQuicklink[]
  playerSegments              PlayerSegment[]
  freebetGrants               FreebetGrant[]
  betAndGetCampaigns          BetAndGetCampaign[]
  promoCards                  PromoCard[]
  homepageCarouselConfig      HomepageCarouselConfig?
  depositCampaigns            DepositCampaign[]
  deposits                    Deposit[]
  depositCampaignRedemptions  DepositCampaignRedemption[]
  registerCampaigns           RegisterCampaign[]
  registerCampaignRedemptions RegisterCampaignRedemption[]
  leaderboardCampaigns        LeaderboardCampaign[]
  leaderboardEntries          LeaderboardEntry[]
  pushNotifications           PushNotification[]
  matchOfTheDayEntries        MatchOfTheDay[]
  topNavItems                 TopNavItem[]

  @@map("brands")
}

enum BrandImageSlot {
  REGISTER_DESKTOP
  REGISTER_MOBILE
  HOMEPAGE_OFFER
  MATCH_OF_THE_DAY
}

/**
 * Staff-uploaded CMS images per brand and slot (see BrandImageSlot) - the
 * register page's promo panel (desktop/mobile) and the homepage offer
 * card. Stored as bytes directly in Postgres rather than an object-storage
 * bucket - no such provider is configured for this deployment, and these
 * are small, infrequently-changed images, so this avoids a new infra
 * dependency. One row per brand+slot; re-uploading replaces it in place.
 */
model BrandImage {
  id        String         @id @default(uuid())
  brandId   String
  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slot      BrandImageSlot
  data      Bytes
  mimeType  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([brandId, slot])
  @@index([brandId])
  @@map("brand_images")
}

/**
 * The brand's own logos, staff-uploaded from the master backoffice - stored
 * as raw bytes the same way as BrandImage, one row per brand+slot. 4 slots:
 * the main site logo and the bet-share image's logo, each with an
 * independent light/dark variant since a single logo often reads badly
 * against one of the two backgrounds. Each upload sets the matching
 * Brand.*LogoUrl field to this row's public serving path (see
 * BrandsService.setLogo) so every consumer keeps reading a plain image URL
 * either way - a manually pasted external URL still works exactly the same
 * for a slot that isn't uploaded to.
 */
enum BrandLogoSlot {
  SITE_LIGHT
  SITE_DARK
  SHARE_LIGHT
  SHARE_DARK
}

model BrandLogo {
  id        String        @id @default(uuid())
  brandId   String
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slot      BrandLogoSlot
  data      Bytes
  mimeType  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([brandId, slot])
  @@index([brandId])
  @@map("brand_logos")
}

enum BrandImageListKind {
  SPONSOR_LOGO
  PAYMENT_METHOD
}

/**
 * Ordered, multi-item image lists per brand (footer sponsor logos, footer
 * payment method icons) - unlike BrandImage's one-per-slot shape, a brand
 * can have any number of these, shown in sortOrder. Same byte-storage
 * reasoning as BrandImage.
 */
model BrandImageListItem {
  id        String             @id @default(uuid())
  brandId   String
  brand     Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kind      BrandImageListKind
  data      Bytes
  mimeType  String
  sortOrder Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([brandId, kind])
  @@map("brand_image_list_items")
}

enum PushNotificationKind {
  CUSTOM
  BET_WON
  BET_AND_GET_CAMPAIGN
  DEPOSIT_CAMPAIGN
  REGISTER_CAMPAIGN
  LEADERBOARD_CAMPAIGN
}

enum PushDeliveryStatus {
  SENT
  FAILED
}

/**
 * One player device's Web Push registration - per-device, since browser
 * permission is inherently per-browser-profile (see WebAuthnCredential, the
 * closest existing per-user-multi-device precedent). endpoint is globally
 * unique the same way WebAuthnCredential.credentialId is - a given push
 * service endpoint URL can only ever belong to one subscription.
 */
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  recipients PushNotificationRecipient[]

  @@index([userId])
  @@map("push_subscriptions")
}

/**
 * One push send event - either a staff-composed CUSTOM broadcast (own
 * audienceMode/segments below, same shape as BetAndGetCampaign/
 * DepositCampaign audience targeting) or a system/campaign-linked one
 * (BET_WON, BET_AND_GET_CAMPAIGN, DEPOSIT_CAMPAIGN), whose audience is
 * resolved live from the linked bet/campaign at send time and not
 * duplicated into audienceMode/segments here - those two fields are only
 * meaningful when kind is CUSTOM. sourceBetId is unique (not just indexed,
 * unlike FreebetGrant.sourceBetId) because exactly one BET_WON push can
 * ever exist per bet - see PushNotificationService.sendBetWonPush's
 * idempotency guard.
 */
model PushNotification {
  id        String               @id @default(uuid())
  brandId   String
  brand     Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kind      PushNotificationKind @default(CUSTOM)
  title     String
  body      String
  /**
   * Deep link opened on notificationclick, e.g. "/my-bets" - relative path within apps/frontend. Null opens the app root.
   */
  targetUrl String?

  /**
   * Only meaningful when kind is CUSTOM and neither campaign FK below is set.
   */
  audienceMode AudienceMode              @default(ALL)
  segments     PushNotificationSegment[]

  betAndGetCampaignId   String?
  betAndGetCampaign     BetAndGetCampaign?   @relation(fields: [betAndGetCampaignId], references: [id], onDelete: SetNull)
  depositCampaignId     String?
  depositCampaign       DepositCampaign?     @relation(fields: [depositCampaignId], references: [id], onDelete: SetNull)
  registerCampaignId    String?
  registerCampaign      RegisterCampaign?    @relation(fields: [registerCampaignId], references: [id], onDelete: SetNull)
  leaderboardCampaignId String?
  leaderboardCampaign   LeaderboardCampaign? @relation(fields: [leaderboardCampaignId], references: [id], onDelete: SetNull)

  /**
   * The bet that triggered a BET_WON send - null for every other kind. Also the idempotency key (see the unique constraint below), same role as FreebetGrant.sourceBetId.
   */
  sourceBetId String? @unique

  /**
   * Web Push TTL header value used for this send's fan-out, in seconds - the entire "offline retry" mechanism is the push service honoring this header (RFC 8030), no application-level queue.
   */
  ttlSeconds Int @default(86400)

  /**
   * Denormalized actor snapshot, same pattern as FreebetGrant - both null for a system-triggered (non-CUSTOM, non-staff) send.
   */
  sentByStaffUserId String?
  sentByUsername    String?
  createdAt         DateTime @default(now())

  recipients PushNotificationRecipient[]

  @@index([brandId])
  @@index([createdAt])
  @@map("push_notifications")
}

model PushNotificationSegment {
  id                 String           @id @default(uuid())
  pushNotificationId String
  pushNotification   PushNotification @relation(fields: [pushNotificationId], references: [id], onDelete: Cascade)
  segmentId          String
  segment            PlayerSegment    @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([pushNotificationId, segmentId])
  @@map("push_notification_segments")
}

/**
 * One recipient's delivery outcome for one PushNotification - the "who did
 * this affect" record, same split as PushNotification itself being "the
 * event" (mirrors how BetAndGetCampaign is the event and FreebetGrant is
 * the per-user record). pushSubscriptionId is nullable (SetNull) so a
 * delivery record survives the player later unsubscribing that device;
 * endpoint is denormalized so which physical device received it stays
 * legible even then.
 */
model PushNotificationRecipient {
  id                 String             @id @default(uuid())
  pushNotificationId String
  pushNotification   PushNotification   @relation(fields: [pushNotificationId], references: [id], onDelete: Cascade)
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscriptionId String?
  pushSubscription   PushSubscription?  @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)
  endpoint           String
  status             PushDeliveryStatus
  statusCode         Int?
  errorMessage       String?
  sentAt             DateTime           @default(now())

  @@index([pushNotificationId])
  @@index([userId])
  @@map("push_notification_recipients")
}

/**
 * product is a free-text key (validated against a known list in the DTO,
 * not a DB enum) so adding a new product doesn't require a migration -
 * see KNOWN_PRODUCTS in apps/backend/src/modules/master/dto.
 */
model BrandProductFlag {
  id      String  @id @default(uuid())
  brandId String
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product String
  enabled Boolean @default(false)

  @@unique([brandId, product])
  @@map("brand_product_flags")
}
