generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  /**
   * Kept globally unique rather than unique-per-brand for now: there's no
   * domain-based tenant resolution yet (see PROJECT_BRIEF.md Section 10),
   * so a pre-auth request (register, login) has no other way to know
   * which brand it's for. Login therefore still looks a user up globally
   * by email/username and reads brandId off the row it finds; register
   * requires an explicit brandId in the request. Revisit once tenant
   * resolution exists - a real deployment will likely want these unique
   * per-brand instead.
   */
  email           String    @unique
  username        String    @unique
  phone           String    @unique
  phoneVerifiedAt DateTime?
  passwordHash    String
  /**
   * Paper money only - no real payments/currency handling yet, see PROJECT_BRIEF.md Section 10.
   */
  balanceCents    Int       @default(100000)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /**
   * Captured client-side on the register page's first mount (see
   * RegisterPage), not at submit, so it survives a player browsing around
   * before actually signing up. Nullable and forward-only - there's no way
   * to backfill these for users who registered before this existed.
   */
  referrerUrl String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[]
  bets          Bet[]
  segments      PlayerSegmentMember[]
  freebetGrants FreebetGrant[]

  @@index([brandId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum StaffRole {
  ADMIN
  TRADING
  RISK
  CRM
  FRAUD
  CMS
}

/**
 * A wholly separate identity system from User (players) - not a shared
 * login. See PROJECT_BRIEF.md Section 10: backoffice staff auth explicitly
 * isn't the same system as player auth. Kept globally unique on
 * email/username for the same pre-auth-lookup reason as User - see the
 * comment there.
 */
model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         StaffRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  refreshTokens StaffRefreshToken[]

  @@index([brandId])
  @@map("staff_users")
}

model StaffRefreshToken {
  id          String    @id @default(uuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
  @@map("staff_refresh_tokens")
}

enum AuditAction {
  STAFF_USER_BOOTSTRAPPED
  STAFF_USER_CREATED
  SELECTION_SETTLED
  MARKET_SUSPENDED
  MARKET_UNSUSPENDED
  COMPETITION_RANKING_SET
  COMPETITION_RANKING_REMOVED
  TEAM_COLOR_SET
  DISPLAY_NAME_OVERRIDE_SET
  BRAND_IMAGE_SET
  BRAND_IMAGE_REMOVED
  COMPETITION_TIER_SET
  COMPETITION_TIER_REMOVED
  MARGIN_CONFIG_SET
  MARGIN_CONFIG_REMOVED
  MARKETING_SPEND_CREATED
  MARKETING_SPEND_REMOVED
  BRAND_IMAGE_LIST_ITEM_ADDED
  BRAND_IMAGE_LIST_ITEM_REMOVED
  BRAND_IMAGE_LIST_REORDERED
  COMPETITION_SUSPENDED
  COMPETITION_UNSUSPENDED
  ODDS_OVERRIDE_SET
  ODDS_OVERRIDE_CLEARED
  MANUAL_MARKET_CREATED
  MANUAL_MARKET_REMOVED
  MANUAL_MARKET_UPDATED
  ODDS_LADDER_RUNG_ADDED
  ODDS_LADDER_RUNG_REMOVED
  ODDS_LADDER_REGENERATED
  BOOST_SET
  BOOST_CLEARED
  ACCA_BOOST_CONFIG_SET
  STAKE_LIMIT_SET
  STAKE_LIMIT_REMOVED
  STAKE_LIMITS_BULK_IMPORTED
  COMPETITION_QUICKLINK_SET
  COMPETITION_QUICKLINK_REMOVED
  PLAYER_SEGMENT_CREATED
  PLAYER_SEGMENT_REMOVED
  PLAYER_SEGMENT_MEMBER_ADDED
  PLAYER_SEGMENT_MEMBER_REMOVED
  MANUAL_MARKET_LIMITS_SET
  BOOST_LIMITS_SET
  BOOST_AUTO_DISABLED
  MANUAL_MARKET_AUTO_DISABLED
  FREEBET_GRANTED
  FREEBET_VOIDED
  ACCA_ROLLBACK_CONFIG_SET
  INSURANCE_BET_CONFIG_SET
}

enum FreebetStatus {
  ACTIVE
  SPENT
  VOIDED
}

/**
 * Where a freebet grant came from - MANUAL is a staff-initiated grant (see
 * FreebetService.grant / the backoffice freebets page); ACCA_ROLLBACK and
 * INSURANCE_BET are reserved for the system-granted rewards those
 * promotions issue on a qualifying loss (see docs/PROJECT_BRIEF.md) - not
 * wired up yet, but the value exists now so granting one later doesn't need
 * its own migration.
 */
enum FreebetSource {
  MANUAL
  ACCA_ROLLBACK
  INSURANCE_BET
}

/**
 * One freebet token - stake-not-returned, single-use, atomic (a bet placed
 * with a freebet must stake exactly this grant's amountCents, not a partial
 * amount - same as how real sportsbook free bets work; the player picks
 * which token to use, not a "balance" they draw down arbitrarily).
 * `status` only ever changes via an explicit actor action (FreebetService.
 * spend on bet placement, .void by staff) - expiry is a read-time
 * condition on expiresAt, not a swept status, since there's no background
 * job infrastructure in this codebase to transition it otherwise.
 */
model FreebetGrant {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId       String
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  amountCents   Int
  source        FreebetSource
  /** Staff-entered free text for a MANUAL grant, e.g. "Goodwill gesture - support ticket #482". Null for system-granted sources. */
  note          String?
  status        FreebetStatus @default(ACTIVE)
  expiresAt     DateTime?
  spentAt       DateTime?
  spentOnBetId  String?
  /** The bet that triggered a system grant (e.g. the losing accumulator an ACCA_ROLLBACK reward refunds) - null for MANUAL grants. Also doubles as the idempotency key so re-settling a bet never grants the reward twice. */
  sourceBetId   String?
  voidedAt      DateTime?
  /** Denormalized actor snapshot, same pattern as AuditLogEntry - null for a system-granted (non-MANUAL) source. */
  createdByStaffUserId String?
  createdByUsername    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  fundedBet Bet?

  @@index([userId, status])
  @@index([brandId])
  @@index([sourceBetId])
  @@map("freebet_grants")
}

/**
 * Staff-configurable "how important is this competition" ranking, used to
 * sort the sport page's "most important first" view - see
 * apps/odds-engine's competition field on Match (matches
 * the-odds-api.com's sport_title verbatim, e.g. "EPL", "La Liga - Spain").
 * Lower rank = shown first. A competition with no row here sorts after
 * every ranked one (see CompetitionRankingService.rankFor).
 */
model CompetitionRanking {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competition String
  rank        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, competition])
  @@index([brandId])
  @@map("competition_rankings")
}

/**
 * Staff-curated cross-sport shortcut list for the sidebar's "Top
 * Competitions" section - deliberately a separate model from
 * CompetitionRanking. CompetitionRanking orders each sport's own
 * competitions independently for that sport's drill-down; Quicklinks is
 * a single hand-picked ordered list that can mix competitions from any
 * sport (e.g. EPL, Champions League, ATP Finals in one list) for the
 * player-facing sidebar shortcut section. Lower order = shown first.
 */
model CompetitionQuicklink {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competition String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, competition])
  @@index([brandId])
  @@map("competition_quicklinks")
}

/**
 * Which "who can see this" rule a targeted piece of content (manual
 * market, boost, CMS content) uses. SEGMENTS means the viewer must belong
 * to at least one of the content's assigned PlayerSegments - see
 * audience.ts's resolveAudience for the actual check. LOGGED_OUT/
 * LOGGED_IN read the viewer's auth state, resolved softly (no login
 * required to browse) by OptionalPlayerAuthService.
 */
enum AudienceMode {
  ALL
  LOGGED_OUT
  LOGGED_IN
  SEGMENTS
}

/**
 * Staff-curated player groupings for targeting manual markets, boosts,
 * and (future) CMS content to a subset of players - the "CRM segment"
 * referenced throughout trading/CMS tooling. Membership is manual for
 * now (add/remove a player by email or username in the backoffice); rule-
 * based/automatic membership is a later CRM-module concern, not built here.
 */
model PlayerSegment {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       PlayerSegmentMember[]
  manualMarkets ManualMarketSegment[]
  boosts        BoostSegment[]

  @@unique([brandId, name])
  @@index([brandId])
  @@map("player_segments")
}

model PlayerSegmentMember {
  id        String        @id @default(uuid())
  segmentId String
  segment   PlayerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime      @default(now())

  @@unique([segmentId, userId])
  @@index([userId])
  @@map("player_segment_members")
}

/**
 * Which pricing tier a competition falls into (1-4) - set by trading per
 * brand, since two operators running the same feed may want to price the
 * same competition differently. A competition with no row here has no
 * tier, so MarginConfig never applies to it (raw feed odds pass through
 * unchanged) - never guessed to a default tier.
 */
model CompetitionTier {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competition String
  tier        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, competition])
  @@index([brandId])
  @@map("competition_tiers")
}

enum LimitScope {
  GLOBAL
  SPORT
  COUNTRY
  LEAGUE
  MARKET
  /** Targets one specific player (scopeValue = that player's User.id) - the most specific possible scope, overriding whatever the market/league/sport/global cascade would otherwise say for their bets. See stake-limits.ts's player-aware resolution. */
  PLAYER
}

/**
 * Max stake / max liability for one (scope, scopeValue) pairing, optionally
 * narrowed to one CompetitionTier tier (0 = applies regardless of tier).
 * scopeValue is "" for GLOBAL (the brand-wide default) and otherwise the
 * raw feed sport/country/competition/market name, same convention as
 * CompetitionTier/CompetitionRanking - matches are never persisted, so
 * there's no id to key on.
 *
 * A bet resolves its effective cap per field (maxStakeCents,
 * maxLiabilityCents) independently by walking MARKET -> LEAGUE -> COUNTRY
 * -> SPORT -> GLOBAL, tier-specific before tier-agnostic at each level, and
 * taking the first non-null value found - the same "most specific wins"
 * cascade a CSS rule uses (see resolveLegLimit in stake-limits.ts). An
 * accumulator resolves every leg's own cap this way, then uses the
 * smallest one across all legs (resolveBetLimit) - a book's real exposure
 * on an accumulator is bounded by whichever leg is most restrictive, not
 * an average or a sum.
 */
model StakeLimit {
  id                String     @id @default(uuid())
  brandId           String
  brand             Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  scope             LimitScope
  scopeValue        String     @default("")
  tier              Int        @default(0)
  maxStakeCents     Int?
  maxLiabilityCents Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([brandId, scope, scopeValue, tier])
  @@index([brandId])
  @@map("stake_limits")
}

/**
 * Margin percent for a given raw feed market name (e.g. "Match Result") at
 * a given tier (1-4) within a given sport, per brand. Applied to every
 * match whose competition is assigned that tier (see CompetitionTier) and
 * whose sport matches - the same market name at the same tier can carry a
 * different margin per sport (e.g. Football's Match Result vs Tennis's),
 * since "Match Result" isn't a single fungible market across sports. A
 * (sport, tier, marketName) triple with no row here means no margin is
 * applied to that market, same "nothing fabricated" rule as CompetitionTier.
 */
model MarginConfig {
  id            String   @id @default(uuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sport         String
  marketName    String
  tier          Int
  marginPercent Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([brandId, sport, marketName, tier])
  @@index([brandId])
  @@map("margin_configs")
}

/**
 * A manual log of marketing spend, entered by an admin - there's no ad-
 * platform integration yet, so this is deliberately just a ledger an
 * admin fills in by hand. Denormalizes the creating staff member's
 * username (like AuditLogEntry does) rather than a StaffUser FK, so the
 * row still reads sensibly if that staff account is later removed.
 */
model MarketingSpend {
  id                   String   @id @default(uuid())
  brandId              String
  brand                Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  date                 DateTime
  channel              String
  amountCents          Int
  createdByStaffUserId String?
  createdByUsername    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([brandId, date])
  @@map("marketing_spend")
}

/**
 * A real sports team's own brand color - not brand-scoped like
 * CompetitionRanking above, since a team's color doesn't change per
 * operator (Arsenal is the same red everywhere). Rows get created two
 * ways: (1) any staff backoffice can "sync" team names it sees in the odds
 * feed, which inserts new names with colorHex left null, or (2) an admin
 * sets/edits colorHex directly. colorHex is only ever null until a human
 * (or the startup seed of well-known teams) sets it - never guessed.
 */
model TeamColor {
  id        String   @id @default(uuid())
  name      String   @unique
  colorHex  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_colors")
}

enum DisplayNameEntityType {
  SPORT
  COUNTRY
  COMPETITION
  TEAM
  MARKET
  SELECTION
}

/**
 * A nicer label for a raw feed name - e.g. the-odds-api.com's verbose
 * "UEFA Champions League Qualification" shown to players as "UEFA
 * Champions League (Q)" instead. Not brand-scoped or locale-specific (one
 * override, same for every brand and every player) - see the backoffice
 * conversation that asked for this: a single rename, not multi-language
 * i18n. Rows get created the same two ways as TeamColor above: synced from
 * the feed with displayName left null, or set directly by an admin.
 * MARKET/SELECTION cover market names (e.g. "Match Result") and outcome
 * names (e.g. "Home"/"Draw"/"Away") the same way.
 */
model DisplayNameOverride {
  id          String                @id @default(uuid())
  entityType  DisplayNameEntityType
  rawName     String
  displayName String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([entityType, rawName])
  @@map("display_name_overrides")
}

/**
 * Deliberately no FK relation to StaffUser - actor identity is a
 * denormalized snapshot (id + username) so an audit entry survives even
 * if the acting staff account is later deleted. brandId IS a real FK
 * (Brand deletion isn't supported yet, and unlike a staff account, a
 * brand disappearing should take its audit trail with it).
 */
model AuditLogEntry {
  id               String      @id @default(uuid())
  actorStaffUserId String?
  actorUsername    String
  action           AuditAction
  targetType       String
  targetId         String
  metadata         Json?
  createdAt        DateTime    @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([createdAt])
  @@map("audit_log_entries")
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

enum SelectionStatus {
  OPEN
  WON
  LOST
  VOID
}

/**
 * One combined-odds bet, made up of one or more selections (a single bet has exactly one).
 * brandId is denormalized from user.brandId at creation time (rather than
 * joined through User on every query) so bet-listing/reporting queries
 * can filter directly without a join - a player never moves brands, so
 * this can't drift.
 */
model Bet {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId              String
  brand                Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  stakeCents           Int
  combinedOdds         Decimal   @db.Decimal(10, 4)
  potentialPayoutCents Int
  /** The acca boost percent (see AccaBoostConfig) actually applied at placement time - 0 for a single bet or an accumulator that didn't qualify. Stored on the bet, not recomputed later, so a config change never retroactively changes a bet already placed. */
  accaBoostPercent     Float     @default(0)
  /** The insurance premium percent (see InsuranceBetConfig) actually deducted from the payout at placement time - 0 when the player didn't opt in or the feature was off. A non-zero value here is also what settlement checks to decide whether a loss refunds the stake as a freebet. */
  insuranceCostPercent Float     @default(0)
  status               BetStatus @default(PENDING)
  createdAt            DateTime  @default(now())

  /**
   * Null until every selection is settled (or the bet is LOST outright).
   */
  settledPayoutCents Int?
  settledAt          DateTime?

  /** Set only when this bet was funded by a freebet instead of cash (see FreebetService.spend) - stakeCents always equals that grant's amountCents. Settlement never returns the stake for a freebet-funded bet, only the profit (see PamService.settleSelection). */
  freebetGrantId String?       @unique
  freebetGrant   FreebetGrant? @relation(fields: [freebetGrantId], references: [id], onDelete: SetNull)

  selections BetSelection[]

  @@index([userId])
  @@index([brandId])
  @@map("bets")
}

/**
 * Blocks new bets on a match (marketId = ""), one whole market (selectionId
 * = ""), or one specific selection within a market. The odds-engine itself
 * is a stateless read-through proxy over the live feed with no persistence
 * of its own - this is our own DB's record of what trading has locked,
 * checked by PamService.placeBet. Scoped per brand: the same externally-
 * sourced matchId is shared across all brands (one global odds feed), but
 * suspending it is each brand's own trading decision, independent of every
 * other brand's. See also CompetitionSuspension for the coarser "suspend
 * every match in this competition" case, which isn't expressible here
 * since matches themselves are never persisted.
 */
model MarketSuspension {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId     String
  marketId    String   @default("")
  selectionId String   @default("")
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([brandId, matchId, marketId, selectionId])
  @@index([brandId, matchId])
  @@map("market_suspensions")
}

/**
 * Blocks new bets on every match in a named competition, for one brand.
 * Keyed on the competition's raw feed name (matches Match.competition
 * verbatim, e.g. "EPL") rather than an id, since matches/competitions are
 * never persisted - same convention as CompetitionRanking/CompetitionTier.
 */
model CompetitionSuspension {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competition String
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([brandId, competition])
  @@index([brandId])
  @@map("competition_suspensions")
}

/**
 * A trader's manual fixed price for one selection, applied to
 * PublicMatchesController's response after MarginPricingService - takes
 * the final price straight to oddsValue, bypassing the tier/margin
 * calculation entirely for that selection (not a modifier on top of it).
 * Keyed on matchId/marketId/selectionId same as MarketSuspension, since
 * matches are never persisted; scoped per brand like every other trading
 * tool here.
 */
model OddsOverride {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId     String
  marketId    String
  selectionId String
  oddsValue   Float
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, matchId, marketId, selectionId])
  @@index([brandId, matchId])
  @@map("odds_overrides")
}

/**
 * A trader-created market that doesn't exist in the odds feed at all -
 * merged into PublicMatchesController's response as an extra entry in
 * match.markets alongside the feed's own markets. Its selections carry
 * whatever price the trader set directly (no margin pipeline involvement -
 * there's no feed price to apply a margin to). Deleting the market cascades
 * to its selections; editing replaces the name and the whole selection list
 * in one write rather than patching individual selections.
 */
model ManualMarket {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId   String
  name      String
  createdAt DateTime @default(now())

  /** Per-bet cap on a single selection in this market; a bet over this amount is rejected, not silently capped. */
  maxStakeCents Int?
  /**
   * Cap on total exposure across all bets placed on this market. Unlike a
   * boost's maxLiabilityCents, hitting this doesn't remove the market -
   * it's enforced the same way as maxStakeCents: a bet that would push
   * total liability past the cap is rejected outright.
   */
  maxLiabilityCents Int?
  /** Running total of potential payout across bets placed on this market so far - see PamService's liability tracking. */
  currentLiabilityCents Int @default(0)
  /** Who can see this market at all - see AudienceMode. Defaults to everyone, same as before this field existed. */
  audienceMode AudienceMode @default(ALL)
  /** Set once currentLiabilityCents reaches maxLiabilityCents - mergeIntoMatches skips a disabled market, same as if it never existed. Not deleted, so the exposure history stays on the row. */
  disabledAt DateTime?
  /** A manually-priced market has no live re-pricing feed behind it, so it auto-suspends the moment its match goes in-play unless a trader explicitly marks it safe to keep offering live. Defaults to false (auto-suspend), same as every market before this field existed. */
  staysLiveDuringInplay Boolean @default(false)

  selections       ManualMarketSelection[]
  audienceSegments ManualMarketSegment[]

  @@index([brandId, matchId])
  @@map("manual_markets")
}

model ManualMarketSegment {
  id             String        @id @default(uuid())
  manualMarketId String
  manualMarket   ManualMarket  @relation(fields: [manualMarketId], references: [id], onDelete: Cascade)
  segmentId      String
  segment        PlayerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([manualMarketId, segmentId])
  @@map("manual_market_segments")
}

model ManualMarketSelection {
  id             String       @id @default(uuid())
  manualMarketId String
  manualMarket   ManualMarket @relation(fields: [manualMarketId], references: [id], onDelete: Cascade)
  name           String
  odds           Float
  createdAt      DateTime     @default(now())

  @@map("manual_market_selections")
}

/**
 * One rung of a brand's price grid - the only decimal odds a boosted price
 * is ever allowed to land on (see BoostService.applyBoosts / odds-ladder.ts).
 * Seeded per brand via OddsLadderService.regenerateStandard (the real
 * industry-standard tick ladder), then freely added to/removed from by
 * trading. Not tied to any one match/market - one grid covers every
 * selection a brand ever boosts.
 */
model OddsLadderRung {
  id        String   @id @default(uuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  value     Float
  createdAt DateTime @default(now())

  @@unique([brandId, value])
  @@index([brandId])
  @@map("odds_ladder_rungs")
}

/**
 * A trader-configured price boost on one selection: instead of a fixed
 * price (see OddsOverride), this stores how many rungs to climb the
 * brand's OddsLadderRung grid from whatever price the selection would
 * otherwise show - applied as the last step of the public matches pricing
 * pipeline, after margin, manual markets, and overrides, so "the price it
 * would otherwise show" already accounts for all of those. Upsert-keyed
 * like MarketSuspension/OddsOverride, so re-setting a boost on the same
 * selection edits it in place rather than duplicating.
 */
model Boost {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  matchId     String
  marketId    String
  selectionId String
  ticks       Int
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /** Per-bet cap on the boosted selection - shown to players alongside the boosted price, enforced (rejected, not capped) at placement. */
  maxStakeCents Int?
  /** Total extra payout (boosted odds minus original odds, times stake) this boost may give away before it auto-disables. Null means unlimited. */
  maxLiabilityCents Int?
  /** Running total of extra payout given away by bets placed at the boosted price so far - see PamService's liability tracking. */
  currentLiabilityCents Int @default(0)
  /** Set once currentLiabilityCents reaches maxLiabilityCents - applyBoosts skips a disabled boost, same as if it never existed. Not deleted, so the exposure history stays on the row. */
  disabledAt DateTime?
  /** Who can see this boosted price at all - see AudienceMode. Defaults to everyone, same as before this field existed. */
  audienceMode AudienceMode @default(ALL)
  /** A boosted price has no live re-pricing behind the boost itself, so it auto-suspends the moment its match goes in-play unless a trader explicitly marks it safe to keep offering live. Defaults to false (auto-suspend), same as every boost before this field existed. */
  staysLiveDuringInplay Boolean @default(false)

  audienceSegments BoostSegment[]

  @@unique([brandId, matchId, marketId, selectionId])
  @@index([brandId, matchId])
  @@map("boosts")
}

model BoostSegment {
  id        String        @id @default(uuid())
  boostId   String
  boost     Boost         @relation(fields: [boostId], references: [id], onDelete: Cascade)
  segmentId String
  segment   PlayerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([boostId, segmentId])
  @@map("boost_segments")
}

/**
 * A brand's accumulator-boost settings - a single row per brand (never
 * created explicitly; AccaBoostService.getConfig returns sane defaults
 * when none exists yet, same "nothing fabricated until a human sets it"
 * rule as the rest of trading, except here the fallback is "boost off"
 * rather than "no data"). boostPercentPerLeg is added once per selection
 * in a qualifying accumulator (see acca-boost.ts's calculateAccaBoost) -
 * not a flat bonus, not compounding.
 */
model AccaBoostConfig {
  id                 String   @id @default(uuid())
  brandId            String   @unique
  brand              Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  boostPercentPerLeg Float    @default(5)
  minSelections      Int      @default(3)
  minOddsPerLeg      Float    @default(1.2)
  enabled            Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  @@map("acca_boost_configs")
}

/**
 * A brand's accumulator-rollback settings - a single row per brand (same
 * "no row = feature off" default pattern as AccaBoostConfig). When a
 * qualifying accumulator (>= minSelections legs) loses by no more than
 * lossThreshold legs, rewardPercent of the stake is refunded as a freebet
 * (FreebetSource.ACCA_ROLLBACK). Evaluated at settlement time once every
 * leg is terminal - see PamService.settleSelection.
 */
model AccaRollbackConfig {
  id            String   @id @default(uuid())
  brandId       String   @unique
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  minSelections Int      @default(3)
  lossThreshold Int      @default(1)
  rewardPercent Float    @default(100)
  enabled       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("acca_rollback_configs")
}

/**
 * A brand's insurance-bet settings - a single row per brand (same "no row =
 * feature off" default pattern as AccaBoostConfig/AccaRollbackConfig).
 * When a player opts in at placement (any bet - single or accumulator),
 * costPercent is deducted from the potential payout up front as the
 * premium; if the bet then loses at all, the stake comes back as a
 * freebet (FreebetSource.INSURANCE_BET) - see insurance-bet.ts and
 * PamService.
 */
model InsuranceBetConfig {
  id          String   @id @default(uuid())
  brandId     String   @unique
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  costPercent Float    @default(10)
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("insurance_bet_configs")
}

/**
 * A snapshot of what was picked at bet time - not a live reference to the
 * odds feed, which has no persistence of its own and can reshuffle/expire.
 */
model BetSelection {
  id            String          @id @default(uuid())
  betId         String
  bet           Bet             @relation(fields: [betId], references: [id], onDelete: Cascade)
  matchId       String
  marketId      String
  selectionId   String
  matchLabel    String
  marketName    String
  selectionName String
  odds          Decimal         @db.Decimal(10, 2)
  status        SelectionStatus @default(OPEN)

  @@index([betId])
  @@map("bet_selections")
}

/**
 * A wholly separate identity system from both player auth and staff auth -
 * the single-owner login for the master backoffice (apps/master-backoffice),
 * which creates and configures brands. Own JWT secret so a compromised
 * staff or player token is cryptographically incapable of reaching this,
 * not just logically rejected by a payload check. In practice this table
 * is expected to hold very few rows (often just one).
 */
model MasterUser {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens MasterRefreshToken[]

  @@map("master_users")
}

model MasterRefreshToken {
  id           String     @id @default(uuid())
  masterUserId String
  masterUser   MasterUser @relation(fields: [masterUserId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([masterUserId])
  @@map("master_refresh_tokens")
}

enum ThemeMode {
  LIGHT
  DARK
}

/**
 * One sportsbook brand under the master product. Every player, staff
 * account, bet, audit entry, and market suspension belongs to exactly
 * one brand - see PROJECT_BRIEF.md Section 10 for the brandId retrofit.
 */
model Brand {
  id                  String    @id @default(uuid())
  name                String
  /**
   * URL-safe identifier, e.g. for future path-based routing.
   */
  slug                String    @unique
  /**
   * The domain that resolves to this brand, once domain routing exists.
   */
  domain              String?   @unique
  logoUrl             String?
  themeMode           ThemeMode @default(DARK)
  buttonColorHex      String?
  highlightColorHex   String?
  /**
   * Filter/tab active-state and gradient accent color - kept distinct from
   * both the CTA (buttonColorHex) and the general accent (highlightColorHex)
   * so a filter chip never visually reads as a button.
   */
  filterColorHex      String?
  /**
   * Shown on the player-facing Responsible Gambling page when set - never a fabricated phone number if left unset.
   */
  supportHelplineText String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  productFlags           BrandProductFlag[]
  users                  User[]
  staffUsers             StaffUser[]
  bets                   Bet[]
  auditLogEntries        AuditLogEntry[]
  marketSuspensions      MarketSuspension[]
  competitionSuspensions CompetitionSuspension[]
  competitionRankings    CompetitionRanking[]
  images                 BrandImage[]
  imageListItems         BrandImageListItem[]
  competitionTiers       CompetitionTier[]
  marginConfigs          MarginConfig[]
  marketingSpends        MarketingSpend[]
  oddsOverrides          OddsOverride[]
  manualMarkets          ManualMarket[]
  oddsLadderRungs        OddsLadderRung[]
  boosts                 Boost[]
  accaBoostConfig        AccaBoostConfig?
  accaRollbackConfig     AccaRollbackConfig?
  insuranceBetConfig     InsuranceBetConfig?
  stakeLimits            StakeLimit[]
  competitionQuicklinks  CompetitionQuicklink[]
  playerSegments         PlayerSegment[]
  freebetGrants          FreebetGrant[]

  @@map("brands")
}

enum BrandImageSlot {
  REGISTER_DESKTOP
  REGISTER_MOBILE
  HOMEPAGE_OFFER
  MATCH_OF_THE_DAY
}

/**
 * Staff-uploaded CMS images per brand and slot (see BrandImageSlot) - the
 * register page's promo panel (desktop/mobile) and the homepage offer
 * card. Stored as bytes directly in Postgres rather than an object-storage
 * bucket - no such provider is configured for this deployment, and these
 * are small, infrequently-changed images, so this avoids a new infra
 * dependency. One row per brand+slot; re-uploading replaces it in place.
 */
model BrandImage {
  id        String         @id @default(uuid())
  brandId   String
  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slot      BrandImageSlot
  data      Bytes
  mimeType  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([brandId, slot])
  @@index([brandId])
  @@map("brand_images")
}

enum BrandImageListKind {
  SPONSOR_LOGO
  PAYMENT_METHOD
}

/**
 * Ordered, multi-item image lists per brand (footer sponsor logos, footer
 * payment method icons) - unlike BrandImage's one-per-slot shape, a brand
 * can have any number of these, shown in sortOrder. Same byte-storage
 * reasoning as BrandImage.
 */
model BrandImageListItem {
  id        String             @id @default(uuid())
  brandId   String
  brand     Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kind      BrandImageListKind
  data      Bytes
  mimeType  String
  sortOrder Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([brandId, kind])
  @@map("brand_image_list_items")
}

/**
 * product is a free-text key (validated against a known list in the DTO,
 * not a DB enum) so adding a new product doesn't require a migration -
 * see KNOWN_PRODUCTS in apps/backend/src/modules/master/dto.
 */
model BrandProductFlag {
  id      String  @id @default(uuid())
  brandId String
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product String
  enabled Boolean @default(false)

  @@unique([brandId, product])
  @@map("brand_product_flags")
}
