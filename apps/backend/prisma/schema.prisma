generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  phone           String    @unique
  phoneVerifiedAt DateTime?
  passwordHash    String
  /**
   * Paper money only - no real payments/currency handling yet, see PROJECT_BRIEF.md Section 10.
   */
  balanceCents    Int       @default(100000)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens RefreshToken[]
  bets          Bet[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum StaffRole {
  ADMIN
  TRADING
  RISK
  CRM
  FRAUD
  CMS
}

/**
 * A wholly separate identity system from User (players) - not a shared
 * login. See PROJECT_BRIEF.md Section 10: backoffice staff auth explicitly
 * isn't the same system as player auth.
 */
model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         StaffRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens StaffRefreshToken[]

  @@map("staff_users")
}

model StaffRefreshToken {
  id          String    @id @default(uuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
  @@map("staff_refresh_tokens")
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
}

enum SelectionStatus {
  OPEN
  WON
  LOST
  VOID
}

/**
 * One combined-odds bet, made up of one or more selections (a single bet has exactly one).
 */
model Bet {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stakeCents           Int
  combinedOdds         Decimal   @db.Decimal(10, 4)
  potentialPayoutCents Int
  status               BetStatus @default(PENDING)
  createdAt            DateTime  @default(now())

  /**
   * Null until every selection is settled (or the bet is LOST outright).
   */
  settledPayoutCents Int?
  settledAt          DateTime?

  selections BetSelection[]

  @@index([userId])
  @@map("bets")
}

/**
 * A snapshot of what was picked at bet time - not a live reference to the
 * odds feed, which has no persistence of its own and can reshuffle/expire.
 */
model BetSelection {
  id            String          @id @default(uuid())
  betId         String
  bet           Bet             @relation(fields: [betId], references: [id], onDelete: Cascade)
  matchId       String
  marketId      String
  selectionId   String
  matchLabel    String
  marketName    String
  selectionName String
  odds          Decimal         @db.Decimal(10, 2)
  status        SelectionStatus @default(OPEN)

  @@index([betId])
  @@map("bet_selections")
}
